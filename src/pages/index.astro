<script is:inline>
document.addEventListener('DOMContentLoaded', function () {
  setTimeout(boot, 60);
});

function boot() {
  const root = document.getElementById('malek-home');
  if (!root) return;
  const scroller = window;

  // ---- style-hover polyfill (swaps inline styles on hover) ------------
  root.querySelectorAll('[style-hover]').forEach((el) => {
    const original = el.getAttribute('style') || '';
    const hoverCss = el.getAttribute('style-hover') || '';
    const parse = (css) => Object.fromEntries(
      css.split(';').filter(Boolean).map((rule) => {
        const idx = rule.indexOf(':');
        return [rule.slice(0, idx).trim(), rule.slice(idx + 1).trim()];
      })
    );
    const hoverProps = parse(hoverCss);
    el.addEventListener('mouseenter', () => {
      Object.entries(hoverProps).forEach(([k, v]) => { el.style[k] = v; });
    });
    el.addEventListener('mouseleave', () => {
      el.setAttribute('style', original);
    });
  });

  // ---- intro curtain ----------------------------------------------------
  const intro = root.querySelector('#mh-intro');
  if (intro) {
    const mark = intro.querySelector('img');
    requestAnimationFrame(() => { if (mark) mark.style.opacity = '1'; });
    setTimeout(() => {
      intro.style.transition = 'transform 1s cubic-bezier(.76,0,.24,1),opacity .6s ease .35s';
      intro.style.transform = 'translateY(-100%)';
      intro.style.opacity = '0';
    }, 900);
    setTimeout(() => { intro.style.display = 'none'; }, 2100);
  }

  // ---- reveals ------------------------------------------------------------
  const revealed = new WeakSet();
  const items = [...root.querySelectorAll('[data-reveal]')];
  items.forEach((el) => {
    const kind = el.getAttribute('data-reveal');
    el.style.opacity = '0';
    el.style.willChange = 'transform,opacity';
    el.style.transform = kind === 'mask' ? 'translateY(46px)' : 'translateY(26px)';
  });
  const show = (el) => {
    if (revealed.has(el)) return;
    revealed.add(el);
    const d = parseInt(el.getAttribute('data-delay') || '0', 10);
    setTimeout(() => {
      el.style.transition = 'opacity .9s cubic-bezier(.16,1,.3,1),transform 1.05s cubic-bezier(.16,1,.3,1)';
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    }, d);
  };
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) show(e.target); }), { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
  items.forEach((el) => io.observe(el));

  // ---- counters -------------------------------------------------------
  const counters = [...root.querySelectorAll('[data-count-to]')];
  const runCount = (el) => {
    const to = parseFloat(el.getAttribute('data-count-to'));
    const suffix = el.getAttribute('data-suffix') || '';
    const t0 = performance.now(), dur = 1500;
    const tick = (now) => {
      const p = Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(to * e) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const done = new WeakSet();
  const io2 = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting && !done.has(e.target)) { done.add(e.target); runCount(e.target); }
  }), { threshold: 0.5 });
  counters.forEach((el) => io2.observe(el));

  // ---- proceso: active step -------------------------------------------
  const steps = [...root.querySelectorAll('[data-step]')];
  const num = root.querySelector('#mh-procnum');
  const bar = root.querySelector('#mh-procbar');
  const setActive = (el) => {
    steps.forEach((s) => {
      const on = s === el;
      s.style.opacity = on ? '1' : '.32';
      s.style.transform = on ? 'translateX(10px)' : 'translateX(0)';
    });
    const i = parseInt(el.getAttribute('data-step'), 10);
    if (num) num.textContent = String(i).padStart(2, '0');
    if (bar) bar.style.width = (i / steps.length * 100) + '%';
  };
  let activeStep = null;
  const syncSteps = () => {
    if (!steps.length) return;
    const line = window.innerHeight * 0.55;
    let pick = null;
    steps.forEach((s) => { if (s.getBoundingClientRect().top <= line) pick = s; });
    if (!pick) pick = steps[0];
    if (pick !== activeStep) { activeStep = pick; setActive(pick); }
  };

  // ---- portal listing: sube al primer puesto ---------------------------
  const listing = root.querySelector('#mh-listing');
  if (listing) {
    const cards = [...listing.children];
    const malek = cards[0], others = cards.slice(1);
    const step = 122;
    malek.style.transform = 'translateY(' + (step * others.length) + 'px) scale(.97)';
    malek.style.opacity = '0';
    others.forEach((o) => { o.style.transform = 'translateY(-142px)'; });
    const ioL = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      ioL.disconnect();
      setTimeout(() => {
        malek.style.transition = 'transform 1.15s cubic-bezier(.16,1,.3,1),opacity .7s ease';
        malek.style.transform = 'translateY(0) scale(1)';
        malek.style.opacity = '1';
        others.forEach((o, i) => {
          o.style.transition = 'transform 1.15s cubic-bezier(.16,1,.3,1) ' + (0.06 * i) + 's';
          o.style.transform = 'translateY(0)';
        });
      }, 240);
    }), { threshold: 0.3 });
    ioL.observe(listing);
  }

  // ---- parallax + progress --------------------------------------------
  const heroImg = root.querySelector('#mh-heroimg');
  const parallax = [...root.querySelectorAll('[data-parallax]')];
  const prog = root.querySelector('#mh-progress');
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      const vh = window.innerHeight;
      if (heroImg) {
        const r = heroImg.getBoundingClientRect();
        heroImg.style.transform = 'translate3d(0,' + (-r.top * 0.22) + 'px,0) scale(' + (1 + Math.min(0.12, Math.max(0, -r.top) / vh * 0.12)) + ')';
      }
      parallax.forEach((el) => {
        const r = el.getBoundingClientRect();
        const off = (r.top + r.height / 2 - vh / 2) * parseFloat(el.getAttribute('data-parallax'));
        el.style.transform = 'translate3d(0,' + (-off) + 'px,0)';
      });
      syncSteps();
      if (prog) {
        const rr = root.getBoundingClientRect();
        const total = Math.max(1, rr.height - vh);
        prog.style.width = Math.min(100, Math.max(0, (-rr.top / total) * 100)) + '%';
      }
    });
  };
  scroller.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  onScroll();
}

</script>

</body>
</html>
