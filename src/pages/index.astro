---
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getCollection } from 'astro:content';

const properties = (await getCollection('properties')).sort((a, b) => a.data.order - b.data.order);
const primary = properties[0];

const heroImg = primary?.data.coverImage ?? '/images/og-default.jpg';
const planoImg = primary?.data.gallery?.[2] ?? primary?.data.gallery?.[0] ?? heroImg;
const videoPanelImg = primary?.data.gallery?.[1] ?? primary?.data.gallery?.[0] ?? heroImg;
const tourUrl = primary?.data.virtualTourUrl ?? '';
const listingPriceText = primary ? `USD ${primary.data.price.toLocaleString('es-AR')}` : '';
const listingSpecsText = primary
  ? `${primary.data.title} · ${primary.data.ambientes} ambientes · ${primary.data.m2} m²`
  : '';

const waTasarHref = `https://wa.me/5491122540182?text=${encodeURIComponent('Hola! Quiero tasar mi propiedad.')}`;
const waGeneralHref = `https://wa.me/5491122540182?text=${encodeURIComponent('Hola! Quiero más información.')}`;
const waDudasHref = `https://wa.me/5491122540182?text=${encodeURIComponent('Hola! Tengo dudas sobre cómo vender mi propiedad.')}`;
---

<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>Malek Inmobiliaria — Vendé tu propiedad al mayor valor, en el menor tiempo</title>
  <meta name="description" content="Venta residencial en CABA, con dedicación exclusiva a pocos clientes a la vez. Tasación sin cargo." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Malek Inmobiliaria" />
  <meta property="og:description" content="Venta residencial en CABA, con dedicación exclusiva a pocos clientes a la vez." />
  <meta property="og:image" content={heroImg} />
  <meta name="twitter:card" content="summary_large_image" />
  <style is:global>
  @font-face{font-family:'Blacker Sans Display';src:url("/fonts/BlackerSansDisplay-Regular.woff2") format('woff2');font-weight:400;font-style:normal;font-display:swap}
  @font-face{font-family:'Blacker Sans Display';src:url("/fonts/BlackerSansDisplay-Bold.woff2") format('woff2');font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:'Blacker Sans Display';src:url("/fonts/BlackerSansDisplay-ExtraBoldItalic.woff2") format('woff2');font-weight:800;font-style:italic;font-display:swap}
  @font-face{font-family:'Gotham';src:url("/fonts/Gotham-Book.woff2") format('woff2');font-weight:400;font-display:swap}
  @font-face{font-family:'Gotham';src:url("/fonts/Gotham-Bold.woff2") format('woff2');font-weight:700;font-display:swap}
  @font-face{font-family:'Brittany';src:url("/fonts/Brittany.woff2") format('woff2');font-weight:400;font-display:swap}
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:#000}
  #malek-home{margin:0;background:#000;color:#F5F2EC;font-family:'Gotham',sans-serif;-webkit-font-smoothing:antialiased}
  #malek-home a{color:inherit;text-decoration:none}
  #malek-home a:hover{color:#0097D9}
  @keyframes malek-blink{0%,100%{opacity:1}50%{opacity:.15}}
  @keyframes malek-scrolldot{0%{transform:translateY(0);opacity:0}20%{opacity:1}100%{transform:translateY(26px);opacity:0}}
  @keyframes malek-pan{0%{transform:translateX(0) scale(1.35)}50%{transform:translateX(-14%) scale(1.35)}100%{transform:translateX(0) scale(1.35)}}
  @keyframes malek-progress{0%{width:6%}100%{width:96%}}
  @keyframes malek-ticker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
  @keyframes malek-pulse{0%{transform:scale(1);opacity:.55}70%{transform:scale(1.9);opacity:0}100%{transform:scale(1.9);opacity:0}}
  @keyframes malek-spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}

  </style>
</head>
<body>

<div id="malek-home" style="background:#000;overflow-x:clip;position:relative">

  <div id="mh-progress" style="position:fixed;top:0;left:0;height:2px;width:0%;background:#0097D9;z-index:60"></div>

  <div id="mh-intro" style="position:fixed;inset:0;background:#000;z-index:80;display:flex;align-items:center;justify-content:center">
    <img src="/images/logo-malek-white.png" alt="Malek Inmobiliaria" style="width:340px;height:auto;opacity:0;transition:opacity .7s ease">
  </div>

  <header style="position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:22px clamp(20px,4vw,56px);background:rgba(0,0,0,.55);backdrop-filter:blur(14px);border-bottom:1px solid rgba(245,242,236,.08)">
    <img src="/images/logo-malek-white.png" alt="Malek Inmobiliaria" style="width:clamp(120px,13vw,170px);height:auto;display:block">
    <nav style="display:flex;gap:clamp(14px,2.2vw,38px);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#C9C5BE;font-weight:400">
      <a href="#mh-proceso">Proceso</a>
      <a href="#mh-material">Material</a>
      <a href="#mh-jaco">Quién soy</a>
      <a href="#mh-contacto">Contacto</a>
    </nav>
    <a href={waTasarHref} target="_blank" rel="noopener" style="border:1px solid #0097D9;color:#0097D9;font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:500;padding:13px 22px;white-space:nowrap;display:inline-flex;align-items:center;transition:background .4s cubic-bezier(.16,1,.3,1),color .4s ease" style-hover="background:#0097D9;color:#fff">Tasá tu propiedad</a>
  </header>

  <section style="position:relative;height:100vh;min-height:820px;overflow:hidden;margin-top:-79px">
    <div id="mh-heroimg" style="position:absolute;inset:-8% 0;will-change:transform">
      <img src={heroImg} alt="Interior a sangre — living con luz de tarde" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block">
    </div>
    <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.94) 0%,rgba(0,0,0,.72) 38%,rgba(0,0,0,.15) 72%,rgba(0,0,0,.5) 100%);pointer-events:none"></div>
    <div style="position:absolute;left:clamp(20px,4vw,56px);bottom:110px;max-width:820px;pointer-events:none">
      <div data-reveal="up" data-delay="900" style="font-size:11px;letter-spacing:.34em;text-transform:uppercase;color:#0097D9;font-weight:500;margin-bottom:26px">Venta residencial · Ciudad de Buenos Aires</div>
      <h1 style="margin:0;font-family:'Blacker Sans Display',serif;font-weight:700;font-size:clamp(44px,6.6vw,96px);line-height:.98;letter-spacing:-.03em;color:#F5F2EC">
        <span data-reveal="mask" data-delay="1000" style="display:inline-block">Mudarte</span>
        <span data-reveal="mask" data-delay="1080" style="display:inline-block">puede</span>
        <span data-reveal="mask" data-delay="1160" style="display:inline-block">ser</span>
        <span data-reveal="mask" data-delay="1240" style="display:inline-block">una</span>
        <span data-reveal="mask" data-delay="1320" style="display:inline-block">buena</span>
        <span data-reveal="mask" data-delay="1440" style="display:inline-block;font-family:'Brittany',cursive;font-weight:400;font-size:clamp(56px,8.4vw,120px);color:#0097D9;padding:0 .06em">Experiencia</span>
      </h1>
      <div data-reveal="up" data-delay="1600" style="margin-top:30px;font-size:19px;line-height:1.62;color:#C9C5BE;max-width:560px;font-weight:500">Me ocupo de vender tu casa con estrategia, tecnología, proceso claro y acompañamiento profesional. <b style="color:#F5F2EC;font-weight:700">Vos solo pensás en lo que viene.</b></div>
      <div data-reveal="up" data-delay="1720" style="display:flex;gap:14px;margin-top:40px;pointer-events:auto">
        <a href={waTasarHref} target="_blank" rel="noopener" style="background:#0097D9;color:#fff;font-size:13px;letter-spacing:.14em;text-transform:uppercase;font-weight:500;padding:21px 34px;white-space:nowrap;display:inline-flex;align-items:center;transition:transform .5s cubic-bezier(.16,1,.3,1),background .4s ease" style-hover="background:#00618C;color:#fff;transform:translateY(-3px)">Quiero mudarme</a>
        <a href={waGeneralHref} target="_blank" rel="noopener" style="border:1px solid rgba(245,242,236,.35);color:#F5F2EC;font-size:13px;letter-spacing:.14em;text-transform:uppercase;font-weight:500;padding:21px 34px;white-space:nowrap;display:inline-flex;align-items:center;transition:background .45s cubic-bezier(.16,1,.3,1),color .35s ease,transform .5s cubic-bezier(.16,1,.3,1)" style-hover="background:#F5F2EC;color:#000;transform:translateY(-3px)">Hablar por WhatsApp</a>
      </div>
    </div>
    <div style="position:absolute;right:clamp(20px,4vw,56px);bottom:110px;display:flex;flex-direction:column;align-items:center;gap:14px;pointer-events:none">
      <div style="font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#8C8A85;writing-mode:vertical-rl">Scroll</div>
      <div style="width:1px;height:56px;background:rgba(245,242,236,.2);position:relative;overflow:hidden">
        <div style="position:absolute;top:0;left:0;width:1px;height:26px;background:#0097D9;animation:malek-scrolldot 1.8s ease-in-out infinite"></div>
      </div>
    </div>
  </section>

  <div style="background:#0097D9;overflow:hidden;padding:20px 0;position:relative">
    <div style="display:flex;width:max-content;animation:malek-ticker 38s linear infinite">
      <div style="display:flex;align-items:center;gap:clamp(28px,4vw,64px);padding-right:clamp(28px,4vw,64px)">
        <span style="font-family:'Blacker Sans Display',serif;font-size:clamp(17px,1.9vw,26px);font-weight:700;color:#fff;letter-spacing:-.01em;white-space:nowrap">Tasación con informe de mercado, sin cargo</span>
        <span style="width:6px;height:6px;background:#001E2C;flex:0 0 auto"></span>
        <span style="font-family:'Blacker Sans Display',serif;font-size:clamp(17px,1.9vw,26px);font-weight:700;color:#001E2C;letter-spacing:-.01em;white-space:nowrap">Fotos HDR, video, plano y tour virtual</span>
        <span style="width:6px;height:6px;background:#001E2C;flex:0 0 auto"></span>
        <span style="font-family:'Blacker Sans Display',serif;font-size:clamp(17px,1.9vw,26px);font-weight:700;color:#fff;letter-spacing:-.01em;white-space:nowrap">Aviso Superdestacado en los portales</span>
        <span style="width:6px;height:6px;background:#001E2C;flex:0 0 auto"></span>
        <span style="font-family:'Blacker Sans Display',serif;font-size:clamp(17px,1.9vw,26px);font-weight:700;color:#001E2C;letter-spacing:-.01em;white-space:nowrap">Pocas propiedades a la vez, la tuya con foco</span>
        <span style="width:6px;height:6px;background:#001E2C;flex:0 0 auto"></span>
        <span style="font-family:'Blacker Sans Display',serif;font-size:clamp(17px,1.9vw,26px);font-weight:700;color:#fff;letter-spacing:-.01em;white-space:nowrap">Escrituración acompañada de punta a punta</span>
        <span style="width:6px;height:6px;background:#001E2C;flex:0 0 auto"></span>
      </div>
      <div aria-hidden="true" style="display:flex;align-items:center;gap:clamp(28px,4vw,64px);padding-right:clamp(28px,4vw,64px)">
        <span style="font-family:'Blacker Sans Display',serif;font-size:clamp(17px,1.9vw,26px);font-weight:700;color:#fff;letter-spacing:-.01em;white-space:nowrap">Tasación con informe de mercado, sin cargo</span>
        <span style="width:6px;height:6px;background:#001E2C;flex:0 0 auto"></span>
        <span style="font-family:'Blacker Sans Display',serif;font-size:clamp(17px,1.9vw,26px);font-weight:700;color:#001E2C;letter-spacing:-.01em;white-space:nowrap">Fotos HDR, video, plano y tour virtual</span>
        <span style="width:6px;height:6px;background:#001E2C;flex:0 0 auto"></span>
        <span style="font-family:'Blacker Sans Display',serif;font-size:clamp(17px,1.9vw,26px);font-weight:700;color:#fff;letter-spacing:-.01em;white-space:nowrap">Aviso Superdestacado en los portales</span>
        <span style="width:6px;height:6px;background:#001E2C;flex:0 0 auto"></span>
        <span style="font-family:'Blacker Sans Display',serif;font-size:clamp(17px,1.9vw,26px);font-weight:700;color:#001E2C;letter-spacing:-.01em;white-space:nowrap">Pocas propiedades a la vez, la tuya con foco</span>
        <span style="width:6px;height:6px;background:#001E2C;flex:0 0 auto"></span>
        <span style="font-family:'Blacker Sans Display',serif;font-size:clamp(17px,1.9vw,26px);font-weight:700;color:#fff;letter-spacing:-.01em;white-space:nowrap">Escrituración acompañada de punta a punta</span>
        <span style="width:6px;height:6px;background:#001E2C;flex:0 0 auto"></span>
      </div>
    </div>
  </div>

  <section style="padding:clamp(90px,12vw,180px) clamp(20px,4vw,56px) clamp(80px,10vw,150px);display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,6vw,100px);align-items:start">
    <div style="min-width:0">
      <div data-reveal="up" style="font-size:11px;letter-spacing:.34em;text-transform:uppercase;color:#0097D9;font-weight:500;margin-bottom:34px">Por qué trabajar conmigo</div>
      <div style="font-family:'Blacker Sans Display',serif;font-size:clamp(32px,4.6vw,62px);line-height:1.06;letter-spacing:-.03em;font-weight:700;color:#F5F2EC">
        <div data-reveal="mask" style="display:block">Tu hogar no es</div>
        <div data-reveal="mask" data-delay="90" style="display:block">una ficha más</div>
        <div data-reveal="mask" data-delay="180" style="display:block;font-family:'Brittany',cursive;font-weight:400;font-size:clamp(40px,5.8vw,78px);color:#0097D9;margin-top:6px">en una cartera</div>
      </div>
    </div>
    <div style="min-width:0;display:flex;flex-direction:column;gap:30px;padding-top:78px">
      <div data-reveal="up" style="font-size:20px;line-height:1.72;color:#C9C5BE;font-weight:500">Tomo <b style="color:#F5F2EC;font-weight:700">muy pocas propiedades a la vez</b>, y las elijo. Eso me deja dedicarle a la tuya más tiempo, más dinero y más energía de la que puede una inmobiliaria tradicional.</div>
      <div data-reveal="up" data-delay="120" style="font-size:20px;line-height:1.72;color:#C9C5BE;font-weight:500">Mientras una inmobiliaria tradicional reparte su atención entre cientos de avisos, tu casa tiene foco exclusivo hasta el día que se vende.</div>
      <div data-reveal="up" data-delay="220" style="height:1px;background:rgba(245,242,236,.14);margin-top:12px"></div>
      <div data-reveal="up" data-delay="280" style="font-size:14px;letter-spacing:.2em;text-transform:uppercase;color:#F5F2EC;font-weight:700">Nada de alquileres. Nada de dispersión.</div>
    </div>
  </section>

  <section style="padding:0 clamp(20px,4vw,56px) clamp(90px,11vw,170px);display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid rgba(245,242,236,.14)">
    <div style="padding:70px 50px 0 0;min-width:0">
      <div data-count-to="90" style="font-family:'Gotham',sans-serif;font-size:clamp(48px,8.2vw,130px);font-weight:200;line-height:.86;letter-spacing:-.05em;color:#F5F2EC">0</div>
      <div style="width:100%;height:1px;background:#0097D9;margin:26px 0 18px"></div>
      <div style="font-size:15px;line-height:1.6;color:#C9C5BE;font-weight:700">días en promedio, de la publicación a reserva.</div>
    </div>
    <div style="padding:70px 50px 0;border-left:1px solid rgba(245,242,236,.14);min-width:0">
      <div style="display:flex;align-items:baseline"><span style="font-family:'Gotham',sans-serif;font-size:clamp(48px,8.2vw,130px);font-weight:200;line-height:.86;letter-spacing:-.05em;color:#F5F2EC">Top </span><span data-count-to="1" data-suffix="%" style="font-family:'Gotham',sans-serif;font-size:clamp(48px,8.2vw,130px);font-weight:200;line-height:.86;letter-spacing:-.05em;color:#0097D9">0%</span></div>
      <div style="width:100%;height:1px;background:#0097D9;margin:26px 0 18px"></div>
      <div style="font-size:15px;line-height:1.6;color:#C9C5BE;font-weight:700">de las publicaciones mejor posicionadas de CABA.</div>
    </div>
    <div style="padding:70px 0 0 50px;border-left:1px solid rgba(245,242,236,.14);min-width:0">
      <div data-count-to="70" data-suffix="%" style="font-family:'Gotham',sans-serif;font-size:clamp(48px,8.2vw,130px);font-weight:200;line-height:.86;letter-spacing:-.05em;color:#F5F2EC">0%</div>
      <div style="width:100%;height:1px;background:#0097D9;margin:26px 0 18px"></div>
      <div style="font-size:15px;line-height:1.6;color:#C9C5BE;font-weight:700">de éxito: vendo 7 de cada 10 propiedades que publico. El mercado vende solo 2 de cada 10.</div>
    </div>
  </section>

  <section id="mh-premier" style="padding:clamp(90px,11vw,170px) clamp(20px,4vw,56px) clamp(60px,8vw,110px)">
    <div style="display:grid;grid-template-columns:minmax(280px,1fr) 1.15fr;gap:clamp(32px,5vw,80px);align-items:center">
      <div style="min-width:0;display:flex;flex-direction:column;gap:24px">
        <div data-reveal="up" style="font-size:11px;letter-spacing:.34em;text-transform:uppercase;color:#0097D9;font-weight:700">La pieza que decide todo</div>
        <div data-reveal="mask" data-delay="80" style="font-family:'Blacker Sans Display',serif;font-size:clamp(32px,4.6vw,62px);line-height:1.02;letter-spacing:-.03em;font-weight:700;color:#F5F2EC">Sin publicidad, no te ve nadie</div>
        <div data-reveal="up" data-delay="160" style="font-size:18px;line-height:1.75;color:#C9C5BE;font-weight:500;max-width:520px">Tu casa puede tener el mejor material de CABA: si aparece en la página cuatro del portal, no existe. Por eso pago las dos categorías máximas que hay.</div>
        <div data-reveal="up" data-delay="240" style="display:flex;flex-direction:column;gap:0;margin-top:8px">
          <div style="display:flex;gap:18px;padding:20px 0;border-top:1px solid rgba(245,242,236,.16)">
            <div style="font-family:'Gotham',sans-serif;font-size:12px;font-weight:700;color:#0097D9;width:24px">01</div>
            <div><div style="font-family:'Gotham',sans-serif;font-size:16px;font-weight:700;color:#F5F2EC">Inmobiliaria Premier</div><div style="font-size:14px;line-height:1.6;color:#8C8A85;margin-top:6px;font-weight:500">La categoría de anunciante más alta de Zonaprop.</div></div>
          </div>
          <div style="display:flex;gap:18px;padding:20px 0;border-top:1px solid rgba(245,242,236,.16);border-bottom:1px solid rgba(245,242,236,.16)">
            <div style="font-family:'Gotham',sans-serif;font-size:12px;font-weight:700;color:#0097D9;width:24px">02</div>
            <div><div style="font-family:'Gotham',sans-serif;font-size:16px;font-weight:700;color:#F5F2EC">Aviso Superdestacado</div><div style="font-size:14px;line-height:1.6;color:#8C8A85;margin-top:6px;font-weight:500">El nivel máximo disponible para una publicación.</div></div>
          </div>
        </div>
        <div data-reveal="up" data-delay="320" style="font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:#8C8A85;font-weight:700">Más Tienda Oficial en Mercado Libre · Argenprop · Inmuebles</div>
      </div>

      <div style="min-width:0;background:#F5F2EC;padding:18px;overflow:hidden">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;padding-bottom:14px;border-bottom:1px solid #DCD6CB">
          <div style="display:flex;gap:7px"><div style="width:9px;height:9px;border-radius:50%;background:#DCD6CB"></div><div style="width:9px;height:9px;border-radius:50%;background:#DCD6CB"></div><div style="width:9px;height:9px;border-radius:50%;background:#DCD6CB"></div></div>
          <div style="flex:1;background:#fff;border:1px solid #DCD6CB;padding:9px 14px;font-family:'Gotham',sans-serif;font-size:12px;font-weight:500;color:#4A4844;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Departamentos en venta · Ciudad de Buenos Aires</div>
          <div style="background:#0097D9;color:#fff;font-size:11px;font-weight:700;letter-spacing:.1em;padding:9px 14px;white-space:nowrap">BUSCAR</div>
        </div>
        <div style="display:flex;gap:8px;padding:14px 0 16px;flex-wrap:wrap">
          <div style="border:1px solid #DCD6CB;color:#4A4844;font-size:11px;font-weight:500;padding:6px 12px">3 ambientes</div>
          <div style="border:1px solid #DCD6CB;color:#4A4844;font-size:11px;font-weight:500;padding:6px 12px">Hasta USD 250.000</div>
          <div style="border:1px solid #DCD6CB;color:#4A4844;font-size:11px;font-weight:500;padding:6px 12px">Con balcón</div>
        </div>
        <div id="mh-listing" style="display:flex;flex-direction:column;gap:10px">
          <div data-listing="malek" style="display:flex;gap:14px;background:#fff;border:2px solid #0097D9;padding:12px;height:132px;position:relative;will-change:transform">
            <div style="position:absolute;left:-2px;top:-2px;background:#0097D9;color:#fff;font-size:9px;font-weight:700;letter-spacing:.14em;padding:5px 9px">SUPERDESTACADO</div>
            <div style="width:150px;flex:0 0 150px;background:#E7DFD2;overflow:hidden;position:relative"><img src={heroImg} alt="" style="width:100%;height:100%;object-fit:cover;display:block"></div>
            <div style="flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:5px;padding-top:10px">
