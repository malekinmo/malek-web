---
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const properties = await getCollection('properties');
  return properties.map((p) => ({ params: { slug: p.id }, props: { property: p } }));
}

const { property } = Astro.props;
const { data } = property;
const { Content } = await render(property);

const waHref = `https://wa.me/${data.whatsappNumber}?text=${encodeURIComponent(data.whatsappMessage)}`;
const waTasarHref = `https://wa.me/5491122540182?text=${encodeURIComponent('Hola! Quiero tasar mi propiedad.')}`;

// Convierte un link normal de YouTube/Vimeo al formato de embed.
function toEmbedUrl(url?: string): string | null {
  if (!url) return null;
  try {
    const u = new URL(url);
    if (u.hostname.includes('youtu.be')) return `https://www.youtube.com/embed/${u.pathname.replace('/', '')}`;
    if (u.hostname.includes('youtube.com')) {
      if (u.pathname.startsWith('/embed/')) return url;
      const id = u.searchParams.get('v');
      if (id) return `https://www.youtube.com/embed/${id}`;
    }
    if (u.hostname.includes('vimeo.com')) {
      if (u.hostname.includes('player.vimeo.com')) return url;
      return `https://player.vimeo.com/video/${u.pathname.replace('/', '')}`;
    }
    return url;
  } catch {
    return null;
  }
}
const videoEmbedUrl = toEmbedUrl(data.videoUrl);

// Fotos del visor a pantalla completa: portada + galería (+ plano al final si hay).
const allPhotos = [data.coverImage, ...data.gallery, ...(data.planoImage ? [data.planoImage] : [])];
const galleryOffset = 1; // la portada ocupa el índice 0
const planoIndex = data.planoImage ? allPhotos.length - 1 : -1;

// Destacados de la barra superior — los números van en Gotham.
const quickSpecs = [
  { value: String(data.ambientes), label: 'Ambientes' },
  { value: String(data.banos), label: data.banos > 1 ? 'Baños' : 'Baño' },
  { value: `${data.m2}`, label: 'm² totales' },
  { value: data.orientacion ?? '—', label: 'Orientación' },
];

const detalles = [
  { label: 'Ubicación', value: data.ubicacion ?? '—' },
  { label: 'Antigüedad', value: data.antiguedad ? `${data.antiguedad} años` : '—' },
  { label: 'Expensas', value: data.expensas ? `$${data.expensas.toLocaleString('es-AR')}` : '—' },
  { label: 'ABL', value: data.abl ? `$${data.abl.toLocaleString('es-AR')}` : '—' },
];
---

<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>{data.title} — {data.barrio} | Malek Inmobiliaria</title>
  <meta name="description" content={`${data.title}, ${data.barrio}. ${data.ambientes} ambientes, ${data.m2} m². USD ${data.price.toLocaleString('es-AR')}.`} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${data.title} | Malek Inmobiliaria`} />
  <meta property="og:description" content={`${data.ambientes} ambientes · ${data.m2} m² · ${data.barrio}`} />
  <meta property="og:image" content={data.coverImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <style is:global>
  @font-face{font-family:'Blacker Sans Display';src:url("/fonts/Blacker-Text-Regular-trial.woff2") format('woff2');font-weight:400;font-style:normal;font-display:swap}
  @font-face{font-family:'Blacker Sans Display';src:url("/fonts/Blacker-Text-Regular-Italic-trial.woff2") format('woff2');font-weight:400;font-style:italic;font-display:swap}
  @font-face{font-family:'Blacker Sans Display';src:url("/fonts/Blacker-Text-Medium-trial.woff2") format('woff2');font-weight:500;font-style:normal;font-display:swap}
  @font-face{font-family:'Blacker Sans Display';src:url("/fonts/Blacker-Text-Bold-trial.woff2") format('woff2');font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:'Blacker Sans Display';src:url("/fonts/Blacker-Text-Bold-Italic-trial.woff2") format('woff2');font-weight:700;font-style:italic;font-display:swap}
  @font-face{font-family:'Gotham';src:url("/fonts/GOTHAM-LIGHT.woff2") format('woff2');font-weight:300;font-display:swap}
  @font-face{font-family:'Gotham';src:url("/fonts/GOTHAM-MEDIUM.woff2") format('woff2');font-weight:400;font-display:swap}
  @font-face{font-family:'Gotham';src:url("/fonts/GOTHAM-MEDIUM.woff2") format('woff2');font-weight:500;font-display:swap}
  @font-face{font-family:'Gotham';src:url("/fonts/GOTHAM-BOLD.woff2") format('woff2');font-weight:700;font-display:swap}
  @font-face{font-family:'Gotham';src:url("/fonts/GOTHAM-BLACK.woff2") format('woff2');font-weight:900;font-display:swap}
  @font-face{font-family:'Brittany';src:url("/fonts/Brittany.woff2") format('woff2');font-weight:400;font-display:swap}

  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:#000}
  #mp-root{background:#000;color:#F5F2EC;font-family:'Gotham',sans-serif;-webkit-font-smoothing:antialiased}
  #mp-root a{color:inherit;text-decoration:none}
  .mp-eyebrow{font-size:11px;letter-spacing:.34em;text-transform:uppercase;color:#0097D9;font-weight:500}
  .mp-h2{font-family:'Blacker Sans Display',serif;font-weight:700;font-size:clamp(26px,3.4vw,44px);line-height:1.05;letter-spacing:-.02em;color:#F5F2EC;margin:22px 0 0}
  @keyframes mp-scrolldot{0%{transform:translateY(0);opacity:0}20%{opacity:1}100%{transform:translateY(26px);opacity:0}}

  @media (max-width: 860px){
    .mp-header{padding:16px 20px !important}
    .mp-header img{width:96px !important}
    .mp-nav{display:none !important}
    .mp-hero{height:78vh !important}
    .mp-hero-inner{bottom:44px !important}
    .mp-scrollcue{display:none !important}
    .mp-specs{grid-template-columns:repeat(2,1fr) !important;gap:0 !important}
    .mp-specs > div{border-left:0 !important;border-top:1px solid rgba(245,242,236,.14);padding:26px 0 !important}
    .mp-body{grid-template-columns:1fr !important;gap:44px !important}
    .mp-aside{position:static !important}
    .mp-gallery{grid-template-columns:1fr 1fr !important}
    .mp-cta{flex-direction:column !important;align-items:flex-start !important}
    .mp-cta a{width:100%;justify-content:center !important}
    .mp-footer{flex-direction:column !important;align-items:flex-start !important;gap:22px !important}
  }
  </style>
</head>
<body>

<div id="mp-root">

  <!-- HEADER -->
  <header class="mp-header" style="position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:22px clamp(20px,4vw,56px);background:rgba(0,0,0,.55);backdrop-filter:blur(14px);border-bottom:1px solid rgba(245,242,236,.08)">
    <a href="/" aria-label="Malek Inmobiliaria - Inicio" style="display:block">
      <img src="/images/logo-malek-white.png" alt="Malek Inmobiliaria" style="width:clamp(120px,13vw,170px);height:auto;display:block">
    </a>
    <nav class="mp-nav" style="display:flex;gap:clamp(14px,2.2vw,38px);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#C9C5BE;font-weight:400">
      <a href="/propiedades">Propiedades</a>
      <a href="/blog">Blog</a>
      <a href="/">Vender mi casa</a>
    </nav>
    <a href={waHref} target="_blank" rel="noopener" style="border:1px solid #0097D9;color:#0097D9;font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:500;padding:13px 22px;white-space:nowrap;display:inline-flex;align-items:center;transition:background .4s cubic-bezier(.16,1,.3,1),color .4s ease" style-hover="background:#0097D9;color:#fff">Consultar</a>
  </header>

  <!-- HERO -->
  <section class="mp-hero" style="position:relative;height:88vh;min-height:520px;overflow:hidden">
    <img id="mp-heroimg" src={data.coverImage} alt={data.title} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;will-change:transform">
    <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.92) 0%,rgba(0,0,0,.35) 45%,rgba(0,0,0,.5) 100%);pointer-events:none"></div>
    <button data-lightbox-open data-index="0" aria-label="Ver las fotos a pantalla completa" style="all:unset;position:absolute;inset:0;cursor:zoom-in;display:block"></button>

    <div style="position:absolute;top:calc(50% - 20px);left:50%;transform:translateX(-50%);display:inline-flex;align-items:center;gap:10px;border:1px solid rgba(245,242,236,.4);background:rgba(0,0,0,.3);backdrop-filter:blur(6px);padding:12px 22px;pointer-events:none">
      <span style="font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#F5F2EC;font-weight:500">Ver fotos</span>
      <span style="font-family:'Gotham',sans-serif;font-size:11px;color:#0097D9;font-weight:700">{allPhotos.length}</span>
    </div>

    <div class="mp-hero-inner" style="position:absolute;left:clamp(20px,4vw,56px);right:clamp(20px,4vw,56px);bottom:76px;pointer-events:none">
      <div data-reveal="up" style="display:inline-flex;align-items:center;gap:10px;background:rgba(0,151,217,.16);border:1px solid rgba(0,151,217,.5);padding:8px 16px;margin-bottom:26px">
        <span style="width:6px;height:6px;border-radius:50%;background:#0097D9;display:block"></span>
        <span style="font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#0097D9;font-weight:500">En venta · {data.barrio}</span>
      </div>
      <h1 data-reveal="mask" data-delay="90" style="font-family:'Blacker Sans Display',serif;font-weight:700;font-size:clamp(38px,7vw,96px);line-height:.98;letter-spacing:-.035em;color:#F5F2EC;margin:0;max-width:16ch">{data.title}</h1>
      <div data-reveal="up" data-delay="220" style="margin-top:26px;font-family:'Gotham',sans-serif;font-size:clamp(24px,3.4vw,42px);font-weight:300;letter-spacing:-.02em;color:#0097D9">USD {data.price.toLocaleString('es-AR')}</div>
    </div>

    <div class="mp-scrollcue" style="position:absolute;right:clamp(20px,4vw,56px);bottom:76px;display:flex;flex-direction:column;align-items:center;gap:12px;pointer-events:none">
      <span style="font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:#8C8A85;writing-mode:vertical-rl">Scroll</span>
      <span style="width:1px;height:34px;background:rgba(245,242,236,.25);position:relative;overflow:hidden"><span style="position:absolute;inset:0;background:#0097D9;animation:mp-scrolldot 1.9s ease-in-out infinite"></span></span>
    </div>
  </section>

  <!-- SPECS -->
  <section class="mp-specs" style="display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid rgba(245,242,236,.14);padding:0 clamp(20px,4vw,56px)">
    {quickSpecs.map((s, i) => (
      <div data-reveal="up" data-delay={i * 70} style={`padding:40px 34px;min-width:0;${i > 0 ? 'border-left:1px solid rgba(245,242,236,.14);' : ''}`}>
        <div style="font-family:'Gotham',sans-serif;font-size:clamp(30px,4vw,54px);font-weight:200;line-height:.9;letter-spacing:-.04em;color:#F5F2EC">{s.value}</div>
        <div style="margin-top:14px;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#8C8A85">{s.label}</div>
      </div>
    ))}
  </section>

  <!-- DESCRIPCIÓN + DETALLES -->
  <section class="mp-body" style="display:grid;grid-template-columns:1.55fr 1fr;gap:clamp(32px,6vw,96px);padding:clamp(70px,9vw,130px) clamp(20px,4vw,56px);align-items:start">
    <div style="min-width:0">
      <div data-reveal="up" class="mp-eyebrow">La propiedad</div>
      <h2 data-reveal="up" data-delay="60" class="mp-h2">Sobre esta casa</h2>
      <div data-reveal="up" data-delay="120" class="mp-prose" style="margin-top:30px;font-size:17px;line-height:1.85;color:#C9C5BE">
        <Content />
      </div>
    </div>

    <aside class="mp-aside" data-reveal="up" data-delay="160" style="position:sticky;top:120px;min-width:0;border:1px solid rgba(245,242,236,.16);padding:clamp(24px,3vw,36px);background:rgba(245,242,236,.03)">
      <div class="mp-eyebrow">Detalles</div>
      <dl style="margin:26px 0 0">
        {detalles.map((d) => (
          <div style="display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid rgba(245,242,236,.12)">
            <dt style="font-size:13px;color:#8C8A85">{d.label}</dt>
            <dd style="margin:0;font-size:14px;font-weight:700;color:#F5F2EC;text-align:right">{d.value}</dd>
          </div>
        ))}
      </dl>
      <a href={waHref} target="_blank" rel="noopener" style="margin-top:30px;background:#0097D9;color:#fff;font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:500;padding:19px 24px;display:flex;align-items:center;justify-content:center;transition:background .4s ease,transform .5s cubic-bezier(.16,1,.3,1)" style-hover="background:#00618C;transform:translateY(-3px)">Agendar una visita</a>
      <div style="margin-top:16px;font-size:12px;line-height:1.6;color:#8C8A85;text-align:center">Coordinamos el horario que te quede cómodo.</div>
    </aside>
  </section>

  {data.gallery.length > 0 && (
    <section style="padding:0 clamp(20px,4vw,56px) clamp(70px,9vw,130px)">
      <div data-reveal="up" class="mp-eyebrow">Galería</div>
      <h2 data-reveal="up" data-delay="60" class="mp-h2" style="margin-bottom:38px">Recorré cada ambiente</h2>
      <div class="mp-gallery" style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
        {data.gallery.map((src, i) => (
          <button data-reveal="up" data-delay={Math.min(i, 5) * 60} data-lightbox-open data-index={i + galleryOffset} aria-label={`Ver foto ${i + 1} a pantalla completa`} style="all:unset;display:block;cursor:zoom-in;position:relative;overflow:hidden;aspect-ratio:4/3">
            <img src={src} alt={`${data.title} — foto ${i + 1}`} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;transition:transform .9s cubic-bezier(.16,1,.3,1)" style-hover="transform:scale(1.06)">
          </button>
        ))}
      </div>
    </section>
  )}

  {videoEmbedUrl && (
    <section style="padding:0 clamp(20px,4vw,56px) clamp(70px,9vw,130px)">
      <div data-reveal="up" class="mp-eyebrow">Video</div>
      <h2 data-reveal="up" data-delay="60" class="mp-h2" style="margin-bottom:38px">Un paseo completo</h2>
      <div data-reveal="up" data-delay="120" style="position:relative;aspect-ratio:16/9;background:#0A0A0A;border:1px solid rgba(245,242,236,.14)">
        <iframe src={videoEmbedUrl} title={`Video — ${data.title}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:0;display:block"></iframe>
      </div>
    </section>
  )}

  {data.virtualTourUrl && (
    <section style="padding:0 clamp(20px,4vw,56px) clamp(70px,9vw,130px)">
      <div data-reveal="up" class="mp-eyebrow">Recorrido virtual</div>
      <h2 data-reveal="up" data-delay="60" class="mp-h2" style="margin-bottom:38px">Entrá desde donde estés</h2>
      <div data-reveal="up" data-delay="120" style="position:relative;aspect-ratio:16/9;background:#0A0A0A;border:1px solid rgba(245,242,236,.14)">
        <iframe src={data.virtualTourUrl} title={`Tour virtual — ${data.title}`} loading="lazy" allow="fullscreen; xr-spatial-tracking; gyroscope; accelerometer" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:0;display:block"></iframe>
      </div>
    </section>
  )}

  {data.planoImage && (
    <section style="padding:0 clamp(20px,4vw,56px) clamp(70px,9vw,130px)">
      <div data-reveal="up" class="mp-eyebrow">Plano</div>
      <h2 data-reveal="up" data-delay="60" class="mp-h2" style="margin-bottom:38px">Cómo se distribuye</h2>
      <button data-reveal="up" data-delay="120" data-lightbox-open data-index={planoIndex} aria-label="Ver el plano a pantalla completa" style="all:unset;display:block;cursor:zoom-in;width:100%;background:#F5F2EC;padding:clamp(20px,3vw,44px)">
        <img src={data.planoImage} alt={`Plano — ${data.title}`} loading="lazy" style="width:100%;max-width:820px;margin:0 auto;display:block">
      </button>
    </section>
  )}

  <!-- CTA -->
  <section class="mp-cta" style="background:#0097D9;padding:clamp(50px,7vw,90px) clamp(20px,4vw,56px);display:flex;align-items:center;justify-content:space-between;gap:26px;flex-wrap:wrap">
    <div data-reveal="up" style="font-family:'Blacker Sans Display',serif;font-weight:700;font-size:clamp(24px,3.2vw,40px);line-height:1.1;color:#fff;max-width:620px">¿Querés conocerla en persona?</div>
    <a data-reveal="up" data-delay="100" href={waHref} target="_blank" rel="noopener" style="background:#0A0A0A;color:#fff;font-size:13px;letter-spacing:.16em;text-transform:uppercase;font-weight:500;padding:24px 40px;white-space:nowrap;display:inline-flex;align-items:center;transition:transform .6s cubic-bezier(.16,1,.3,1),background .4s ease" style-hover="background:#F5F2EC;color:#0A0A0A;transform:translateY(-4px)">Escribime por WhatsApp</a>
  </section>

  <!-- VENDER -->
  <section style="padding:clamp(70px,9vw,120px) clamp(20px,4vw,56px);text-align:center">
    <div data-reveal="up" style="font-family:'Brittany',cursive;font-size:clamp(30px,4.6vw,56px);color:#0097D9;line-height:1">¿Y si la que vendés es la tuya?</div>
    <div data-reveal="up" data-delay="90" style="margin-top:22px;font-size:16px;line-height:1.7;color:#C9C5BE;max-width:56ch;margin-inline:auto">Trabajo con hasta 10 propiedades a la vez para poder dedicarle a cada una el tiempo que necesita. Si estás pensando en mudarte, hablemos.</div>
    <a data-reveal="up" data-delay="160" href={waTasarHref} target="_blank" rel="noopener" style="margin-top:34px;border:1px solid rgba(245,242,236,.35);color:#F5F2EC;font-size:13px;letter-spacing:.14em;text-transform:uppercase;font-weight:500;padding:21px 34px;display:inline-flex;align-items:center;transition:background .45s cubic-bezier(.16,1,.3,1),color .35s ease,transform .5s cubic-bezier(.16,1,.3,1)" style-hover="background:#F5F2EC;color:#000;transform:translateY(-3px)">Quiero tasar mi propiedad</a>
  </section>

  <!-- FOOTER -->
  <footer class="mp-footer" style="background:#000;padding:clamp(36px,5vw,60px) clamp(20px,4vw,56px);display:flex;justify-content:space-between;align-items:center;gap:40px;border-top:1px solid rgba(245,242,236,.1)">
    <a href="/" aria-label="Malek Inmobiliaria - Inicio" style="display:block">
      <img src="/images/logo-malek-white.png" alt="Malek Inmobiliaria" style="width:clamp(120px,13vw,170px);height:auto;display:block">
    </a>
    <div style="display:flex;gap:26px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#8C8A85;flex-wrap:wrap">
      <a href="/propiedades">Propiedades</a>
      <a href="https://instagram.com/vendeconjaco" target="_blank" rel="noopener">@vendeconjaco</a>
      <span>CPI 8865</span>
    </div>
  </footer>

  <!-- VISOR A PANTALLA COMPLETA -->
  <div class="mp-lightbox" data-lightbox hidden>
    <button class="mp-lb-close" data-lightbox-close aria-label="Cerrar">✕</button>
    <button class="mp-lb-nav mp-lb-prev" data-lightbox-prev aria-label="Foto anterior">‹</button>
    <img class="mp-lb-img" data-lightbox-img src="" alt="" />
    <button class="mp-lb-nav mp-lb-next" data-lightbox-next aria-label="Foto siguiente">›</button>
    <p class="mp-lb-counter" data-lightbox-counter></p>
  </div>

</div>

<WhatsAppButton number={data.whatsappNumber} message={data.whatsappMessage} />

<style is:global>
  .mp-prose p{margin:0 0 1.3em}
  .mp-prose p:last-child{margin-bottom:0}

  .mp-lightbox{position:fixed;inset:0;background:rgba(5,5,5,.97);z-index:100;display:none;align-items:center;justify-content:center}
  .mp-lightbox:not([hidden]){display:flex}
  .mp-lb-img{max-width:92vw;max-height:86vh;object-fit:contain}
  .mp-lb-close,.mp-lb-nav{position:absolute;background:rgba(245,242,236,.1);color:#F5F2EC;border:0;cursor:pointer;display:grid;place-items:center;transition:background .3s ease}
  .mp-lb-close:hover,.mp-lb-nav:hover{background:#0097D9}
  .mp-lb-close{top:20px;right:20px;width:46px;height:46px;font-size:1.2rem;border-radius:50%}
  .mp-lb-nav{top:50%;transform:translateY(-50%);width:54px;height:54px;font-size:2rem;border-radius:50%}
  .mp-lb-prev{left:20px}
  .mp-lb-next{right:20px}
  .mp-lb-counter{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);color:#8C8A85;font-size:12px;letter-spacing:.2em;margin:0;font-family:'Gotham',sans-serif}
  @media (max-width:860px){
    .mp-lb-nav{width:44px;height:44px;font-size:1.5rem}
    .mp-lb-prev{left:8px}
    .mp-lb-next{right:8px}
  }
</style>

<script is:inline define:vars={{ photos: allPhotos, title: data.title }}>
document.addEventListener('DOMContentLoaded', function () {
  const root = document.getElementById('mp-root');
  if (!root) return;

  // ---- style-hover: aplica estilos inline al pasar el mouse ----
  root.querySelectorAll('[style-hover]').forEach((el) => {
    const original = el.getAttribute('style') || '';
    const hoverCss = el.getAttribute('style-hover') || '';
    const hoverProps = Object.fromEntries(
      hoverCss.split(';').filter(Boolean).map((rule) => {
        const idx = rule.indexOf(':');
        return [rule.slice(0, idx).trim(), rule.slice(idx + 1).trim()];
      })
    );
    el.addEventListener('mouseenter', () => {
      Object.entries(hoverProps).forEach(([k, v]) => { el.style[k] = v; });
    });
    el.addEventListener('mouseleave', () => { el.setAttribute('style', original); });
  });

  // ---- revelados al hacer scroll ----
  const items = [...root.querySelectorAll('[data-reveal]')];
  items.forEach((el) => {
    el.style.opacity = '0';
    el.style.willChange = 'transform,opacity';
    el.style.transform = el.getAttribute('data-reveal') === 'mask' ? 'translateY(42px)' : 'translateY(24px)';
  });
  const revealed = new WeakSet();
  const show = (el) => {
    if (revealed.has(el)) return;
    revealed.add(el);
    const d = parseInt(el.getAttribute('data-delay') || '0', 10);
    setTimeout(() => {
      el.style.transition = 'opacity .9s cubic-bezier(.16,1,.3,1),transform 1.05s cubic-bezier(.16,1,.3,1)';
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    }, d);
  };
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => { if (e.isIntersecting) show(e.target); }),
    { threshold: 0.15, rootMargin: '0px 0px -6% 0px' }
  );
  items.forEach((el) => io.observe(el));
  // El hero se muestra de entrada, sin esperar scroll.
  root.querySelectorAll('.mp-hero-inner [data-reveal]').forEach(show);

  // ---- parallax del hero ----
  const heroImg = document.getElementById('mp-heroimg');
  let ticking = false;
  const onScroll = () => {
    if (ticking || !heroImg) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      const r = heroImg.getBoundingClientRect();
      const vh = window.innerHeight;
      heroImg.style.transform =
        'translate3d(0,' + (-r.top * 0.18) + 'px,0) scale(' +
        (1 + Math.min(0.1, Math.max(0, -r.top) / vh * 0.1)) + ')';
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  onScroll();

  // ---- visor a pantalla completa ----
  const lightbox = document.querySelector('[data-lightbox]');
  const imgEl = document.querySelector('[data-lightbox-img]');
  const counterEl = document.querySelector('[data-lightbox-counter]');
  if (!lightbox || !imgEl) return;
  let currentIndex = 0;
  const update = () => {
    imgEl.src = photos[currentIndex];
    imgEl.alt = title;
    if (counterEl) counterEl.textContent = (currentIndex + 1) + ' / ' + photos.length;
  };
  const open = (i) => {
    currentIndex = i;
    update();
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  };
  const close = () => { lightbox.hidden = true; document.body.style.overflow = ''; };
  const next = () => { currentIndex = (currentIndex + 1) % photos.length; update(); };
  const prev = () => { currentIndex = (currentIndex - 1 + photos.length) % photos.length; update(); };

  document.querySelectorAll('[data-lightbox-open]').forEach((btn) => {
    btn.addEventListener('click', () => open(Number(btn.getAttribute('data-index'))));
  });
  document.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
  document.querySelector('[data-lightbox-next]')?.addEventListener('click', next);
  document.querySelector('[data-lightbox-prev]')?.addEventListener('click', prev);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
  document.addEventListener('keydown', (e) => {
    if (lightbox.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') next();
    if (e.key === 'ArrowLeft') prev();
  });
});
</script>

</body>
</html>
