---
interface Props {
  eyebrow: string;
  title: string;
  updated: string;
}
const { eyebrow, title, updated } = Astro.props;
---
<article class="legal-page container">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="updated">Última actualización: {updated}</p>
  <div class="legal-body">
    <slot />
  </div>
</article>

<style>
  .legal-page { max-width: 780px; padding-top: var(--space-5); padding-bottom: var(--space-5); }
  .legal-page h1 { font-size: clamp(2rem, 5vw, 3rem); margin-top: var(--space-1); }
  .updated { font-family: var(--font-body); font-size: 0.85rem; color: var(--gray-900); margin-top: var(--space-2); }
  .legal-body { margin-top: var(--space-4); font-family: var(--font-body); line-height: 1.7; }
  .legal-body :global(h2) {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.1rem;
    margin: var(--space-4) 0 var(--space-2);
    color: var(--black);
  }
  .legal-body :global(ul) { padding-left: 1.2rem; margin: 0 0 1em; }
  .legal-body :global(li) { margin-bottom: 0.4em; }
  .legal-body :global(a) { color: var(--blue); text-decoration: underline; }
  .legal-body :global(a:hover) { color: var(--blue-dark); }
</style>
