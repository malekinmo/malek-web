---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout title="Blog" description="Consejos y novedades sobre el mercado inmobiliario de Malek Inmobiliaria.">
  <section class="section container">
    <div class="eyebrow-pill" data-reveal>
      <span class="dot"></span>
      <span>Blog</span>
    </div>
    <h1 class="page-title" data-reveal data-delay="60">Notas de Malek Inmobiliaria</h1>
    <p class="page-sub" data-reveal data-delay="120">Educación, trámites y novedades del mercado inmobiliario en CABA.</p>

    <div class="grid">
      {posts.map((post, i) => (
        <a class="card" href={`/blog/${post.id}`} data-reveal data-delay={Math.min(i, 5) * 70}>
          {post.data.coverImage && (
            <div class="card-img-wrap">
              <img src={post.data.coverImage} alt={post.data.title} loading="lazy" />
            </div>
          )}
          <div class="card-body">
            <p class="date">{post.data.publishDate.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            <h2>{post.data.title}</h2>
            <p class="excerpt">{post.data.excerpt}</p>
            <span class="read-more">Leer nota →</span>
          </div>
        </a>
      ))}
    </div>
    {posts.length === 0 && <p style="color: var(--gray-900);">Todavía no hay artículos publicados.</p>}
  </section>
</BaseLayout>
<style>
  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--blue-tint-1);
    border: 1px solid var(--blue-tint-3);
    color: var(--blue-deep);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); display: block; }

  .page-title {
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-2);
  }
  .page-sub {
    color: var(--gray-900);
    font-size: 1.05rem;
    max-width: 46ch;
    margin-bottom: var(--space-5);
  }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }

  .card {
    display: block;
    background: var(--white);
    box-shadow: 0 1px 3px rgba(10,10,10,0.06);
    transition: transform 0.4s cubic-bezier(.16,1,.3,1), box-shadow 0.4s ease;
  }
  .card:hover { transform: translateY(-6px); box-shadow: 0 24px 40px -20px rgba(10,10,10,0.22); }

  .card-img-wrap { overflow: hidden; aspect-ratio: 16/9; }
  .card-img-wrap img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.7s cubic-bezier(.16,1,.3,1);
  }
  .card:hover .card-img-wrap img { transform: scale(1.06); }

  .card-body { padding: var(--space-3); }
  .date { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--blue); margin-bottom: 0.5rem; font-weight: 700; }
  .card h2 { font-size: 1.2rem; line-height: 1.25; letter-spacing: -0.01em; }
  .excerpt { color: var(--gray-900); font-size: 0.92rem; margin-top: 0.6rem; line-height: 1.55; }
  .read-more {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--blue);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  [data-reveal] { opacity: 0; transform: translateY(20px); }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.8s cubic-bezier(.16,1,.3,1), transform 0.9s cubic-bezier(.16,1,.3,1);
  }
  .card.is-visible:hover { transform: translateY(-6px); }

  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const items = document.querySelectorAll('[data-reveal]');
    const show = (el) => {
      const d = parseInt(el.getAttribute('data-delay') || '0', 10);
      setTimeout(() => el.classList.add('is-visible'), d);
    };
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } }),
      { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
    );
    items.forEach((el) => io.observe(el));
  });
</script>
