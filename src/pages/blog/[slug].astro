---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const waHref = 'https://wa.me/5491122540182?text=' + encodeURIComponent(`Hola! Tengo una consulta sobre la nota "${data.title}".`);
---
<BaseLayout title={data.title} description={data.excerpt} ogImage={data.coverImage}>
  <article class="post">
    <header class="post-header container">
      <a href="/blog" class="back">← Volver al blog</a>
      <div class="eyebrow-pill" data-reveal>
        <span class="dot"></span>
        <span>Blog · {data.publishDate.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
      </div>
      <h1 data-reveal data-delay="60">{data.title}</h1>
      <p class="meta" data-reveal data-delay="120">Por {data.author}</p>
    </header>

    {data.coverImage && (
      <div class="cover-wrap container" data-reveal data-delay="160">
        <img class="cover" src={data.coverImage} alt={data.title} />
      </div>
    )}

    <div class="container">
      <div class="prose" data-reveal data-delay="200"><Content /></div>
    </div>
  </article>

  <section class="cta-band">
    <div class="container cta-band-inner">
      <div class="cta-text">¿Tenés dudas sobre tu propiedad?</div>
      <a class="btn cta-btn" href={waHref} target="_blank" rel="noopener">Escribime por WhatsApp</a>
    </div>
  </section>
</BaseLayout>

<style>
  .post-header { max-width: 760px; padding-top: var(--space-4); }
  .back {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--blue);
    margin-bottom: var(--space-3);
  }
  .back:hover { color: var(--blue-dark); }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--blue-tint-1);
    border: 1px solid var(--blue-tint-3);
    color: var(--blue-deep);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-3);
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); display: block; }

  h1 {
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-2);
    max-width: 20ch;
  }
  .meta { color: var(--gray-900); font-size: 0.9rem; margin-bottom: 0; }

  .cover-wrap {
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .cover {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
    box-shadow: 0 18px 40px -20px rgba(0,20,40,0.35);
  }

  .prose { max-width: 760px; margin-inline: auto; color: var(--black); line-height: 1.8; font-size: 1.05rem; font-weight: 300; }
  .prose :global(h2) { font-size: 1.4rem; margin-top: var(--space-4); margin-bottom: var(--space-2); }
  .prose :global(h3) { font-family: var(--font-body); font-weight: 700; font-size: 1.1rem; margin-top: var(--space-3); margin-bottom: 0.6em; }
  .prose :global(p) { margin-bottom: 1.2em; font-weight: 300; }
  .prose :global(a) { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; font-weight: 400; }
  .prose :global(a:hover) { color: var(--blue-dark); }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.2em; padding-left: 1.3em; }
  .prose :global(li) { margin-bottom: 0.5em; font-weight: 300; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--gray-100); margin: var(--space-4) 0; }

  /* Bloque CTA: en el markdown se escribe como cita, con el link en su propio renglón
     > **Título del CTA**
     > Texto breve.
     >
     > [Texto del botón →](https://wa.me/...) */
  .prose :global(blockquote) {
    margin: var(--space-4) 0;
    padding: 1.75rem 2rem;
    background: linear-gradient(135deg, var(--blue-deep), var(--blue));
    border-left: none;
    border-radius: var(--radius);
    font-size: 1.05rem;
  }
  .prose :global(blockquote p) { margin-bottom: 0.5em; font-weight: 700; color: var(--white); }
  .prose :global(blockquote p:last-of-type) { margin-bottom: 0; }
  .prose :global(blockquote p:has(a:only-child)) { margin-top: 0.5em; }
  .prose :global(blockquote a) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    color: var(--blue-deep);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.2s ease, transform 0.3s cubic-bezier(.16,1,.3,1);
  }
  .prose :global(blockquote a:hover) { background: var(--blue-tint-1); color: var(--blue-deep); transform: translateY(-2px); }

  /* Tablas comparativas (ej. tasas por banco) */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-3) 0 var(--space-4);
    font-size: 0.92rem;
  }
  .prose :global(th) {
    background: var(--blue);
    color: var(--white);
    text-align: left;
    padding: 0.6rem 0.8rem;
    font-weight: 700;
  }
  .prose :global(td) {
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--gray-100);
  }
  .prose :global(tr:nth-child(even) td) { background: var(--gray-100); }

  /* CTA band de cierre */
  .cta-band {
    background: var(--blue);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    margin-top: var(--space-6);
  }
  .cta-band-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .cta-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    line-height: 1.1;
    color: var(--white);
    max-width: 520px;
  }
  .cta-btn {
    background: var(--black);
    color: var(--white);
    white-space: nowrap;
    transition: background 0.25s ease, transform 0.4s cubic-bezier(.16,1,.3,1);
  }
  .cta-btn:hover { background: var(--white); color: var(--black); transform: translateY(-3px); }

  [data-reveal] { opacity: 0; transform: translateY(20px); }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.8s cubic-bezier(.16,1,.3,1), transform 0.9s cubic-bezier(.16,1,.3,1);
  }

  @media (max-width: 640px) {
    .prose :global(table) { font-size: 0.82rem; }
    .prose :global(th), .prose :global(td) { padding: 0.5rem 0.5rem; }
    .cta-band-inner { flex-direction: column; align-items: flex-start; }
    .cta-btn { width: 100%; text-align: center; justify-content: center; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const items = document.querySelectorAll('[data-reveal]');
    const show = (el) => {
      const d = parseInt(el.getAttribute('data-delay') || '0', 10);
      setTimeout(() => el.classList.add('is-visible'), d);
    };
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } }),
      { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
    );
    items.forEach((el) => io.observe(el));
  });
</script>
