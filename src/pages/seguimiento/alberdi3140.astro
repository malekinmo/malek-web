---
// Panel de seguimiento para el propietario — Alberdi 3140
// Desde la publicación, esta página es también el informe semanal.
//
// · Informe (números, consultas, portales): src/data/seguimiento/alberdi3140.json → "informe"
//   Lo actualiza n8n (o a mano) cada viernes con los datos hasta el jueves.
// · Recorrido hasta la publicación: sale de Notion vía /api/seguimiento/alberdi3140
//   (worker/index.js). Si Notion no responde, usa "respaldo" del mismo JSON.
import '../../styles/global.css';
import data from '../../data/seguimiento/alberdi3140.json';

const d: any = data;
const inf: any = d.informe;
const R = 54;
const CIRC = +(2 * Math.PI * R).toFixed(2);

const meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
const fFecha = (iso: string) => { const [, m, day] = iso.slice(0, 10).split('-').map(Number); return `${day} ${meses[m - 1]}`; };
const nf = (n: number) => n.toLocaleString('es-AR');
const dias = (a: string, b: string) => Math.round((Date.parse(b) - Date.parse(a)) / 86400000);

// Resumen
const diasPub = dias(inf.fecha_publicacion, inf.generado) + 1;
const ringOffset = +(CIRC * (1 - Math.min(diasPub / inf.dias_autorizacion, 1))).toFixed(2);
const clicsDia = inf.dias.length ? Math.round(inf.totales.clics / inf.dias.length) : 0;
const T = inf.totales;

// Semana
const S = inf.semana;
const tasa = (x: any) => (x && x.exposicion ? (x.clics / x.exposicion) * 100 : 0);
function delta(key: string, abs = false) {
  if (S.primera || !S.anterior) return { cls: 'eq', txt: 'Primera semana' };
  const a = S.actual[key], b = S.anterior[key];
  if (a === b) return { cls: 'eq', txt: '≈ igual' };
  if (abs || !b) { const x = a - b; return { cls: x > 0 ? 'up' : 'down', txt: `${x > 0 ? '▲' : '▼'} ${Math.abs(x)}` }; }
  const p = Math.round(((a - b) / b) * 100);
  return { cls: p > 0 ? 'up' : 'down', txt: `${p > 0 ? '▲' : '▼'} ${Math.abs(p)}%` };
}
const ti = tasa(S.actual), tiAnt = tasa(S.anterior);
const kpis = [
  { lab: 'Exposición', val: S.actual.exposicion, d: delta('exposicion') },
  { lab: 'Clics', val: S.actual.clics, d: delta('clics') },
  { lab: 'Tasa de interés', txt: ti.toFixed(1).replace('.', ',') + '%',
    d: S.primera || !S.anterior ? { cls: 'eq', txt: 'Primera semana' }
      : { cls: ti >= tiAnt ? 'up' : 'down', txt: `${ti >= tiAnt ? '▲' : '▼'} ${Math.abs(ti - tiAnt).toFixed(1).replace('.', ',')} pts` } },
  { lab: 'Consultas', val: S.actual.consultas, d: delta('consultas', true) },
  { lab: 'Visitas', val: S.actual.visitas, d: delta('visitas', true) },
  { lab: 'Descartaron', val: S.actual.descartaron, d: delta('descartaron', true) },
];

// Embudo
const embudo = [
  { lab: 'Exposición', v: T.exposicion, ayuda: 'Veces que el aviso apareció en un listado' },
  { lab: 'Clics', v: T.clics, ayuda: 'Personas que entraron a ver el aviso' },
  { lab: 'Consultas', v: T.consultas, ayuda: 'Personas que escribieron por la propiedad' },
  { lab: 'Visitas', v: T.visitas, ayuda: 'Personas que vinieron a conocerla' },
];
const emax = Math.max(1, T.exposicion);
const embudoW = embudo.map((e) => (e.v ? Math.max(2, Math.sqrt(e.v / emax) * 100) : 0));
const conv = (i: number) => {
  const prev = embudo[i - 1].v;
  return prev ? ((embudo[i].v / prev) * 100).toFixed(1).replace('.', ',') + '%' : '0%';
};

// Gráfico de clics por día (SVG a escala)
const U = inf.umbrales;
const cW = 640, cH = 240, cL = 34, cR = 12, cT = 18, cB = 30;
const cMax = Math.max(U.prueba + 10, ...inf.dias.map((x: any) => x.clics)) * 1.12;
const cy = (v: number) => cT + (cH - cT - cB) * (1 - v / cMax);
const slots = Math.max(inf.dias.length, 7);
const cw = (cW - cL - cR) / slots;
const bw = Math.min(cw * 0.56, 46);
const barras = inf.dias.map((x: any, i: number) => ({
  x: cL + i * cw + (cw - bw) / 2, y: cy(x.clics), h: cy(0) - cy(x.clics), v: x.clics, f: fFecha(x.fecha), ult: i === inf.dias.length - 1,
}));

// Portales
const totPortal = inf.portales.reduce((a: number, p: any) => a + p.consultas, 0);

// Mercado: el primer mes se muestra como avance sobre el promedio del mes
const M = inf.mercado;
const mercado = [
  ['Exposición', T.exposicion, M.exposicion],
  ['Consultas', T.consultas, M.consultas],
  ['Visitas', T.visitas, M.visitas],
].map(([l, a, b]: any) => ({ l, a, b, pct: b ? Math.round((a / b) * 100) : 0 }));

// Consultas agrupadas como en el informe anterior
const DESCARTE = ['descarto', 'no califica', 'sin rta'];
const hace7 = new Date(Date.parse(inf.generado) - 7 * 86400000).toISOString().slice(0, 10);
const grupos: Record<string, any[]> = { nuevas: [], coordinando: [], visitas: [], visitaron: [], descartaron: [] };
[...inf.consultas].sort((a: any, b: any) => b.fecha.localeCompare(a.fecha)).forEach((c: any) => {
  const e = (c.etapa || '').toLowerCase();
  if (DESCARTE.includes(e)) grupos.descartaron.push(c);
  else if (e === 'muestra') grupos.visitas.push(c);
  else if (c.visito) grupos.visitaron.push(c);
  else if (c.fecha >= hace7) grupos.nuevas.push(c);
  else grupos.coordinando.push(c);
});
const tabs = [
  { id: 'nuevas', lab: 'Nuevas', vacio: 'No hay consultas nuevas en los últimos 7 días.' },
  { id: 'coordinando', lab: 'Coordinando', vacio: 'No hay consultas más antiguas sin resolver.' },
  { id: 'visitas', lab: 'Visitas', vacio: 'No hay visitas agendadas todavía.' },
  { id: 'visitaron', lab: 'Visitaron', vacio: 'Todavía nadie visitó el departamento.' },
  { id: 'descartaron', lab: 'Descartaron', vacio: 'Nadie descartó la propiedad todavía.' },
];
const etapaCls = (e: string) => {
  const x = (e || '').toLowerCase();
  if (DESCARTE.includes(x)) return 'is-off';
  if (['compro', 'listo', 'reserva', 'muestra'].includes(x) ) return 'is-hot';
  return '';
};
const porTab = tabs.find((t) => grupos[t.id].length)?.id || 'nuevas';
const wa = 'https://wa.me/5491122540182?text=' + encodeURIComponent(`Hola Jaco! Vi el informe de ${d.propiedad}.`);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Seguimiento de mi venta · {d.propiedad} | Malek Inmobiliaria</title>
    <meta name="description" content={`Cómo viene la venta de ${d.propiedad}, semana a semana.`} />
  </head>
  <body class="sg">
    <div class="sg-noise" aria-hidden="true"></div>

    <header class="sg-top">
      <a href="/" aria-label="Malek Inmobiliaria - Inicio"><img src="/images/logo-malek-white.png" alt="Malek Inmobiliaria" /></a>
      <span class="sg-top-tag"><i></i>Seguimiento en vivo</span>
    </header>

    <!-- ============ HERO ============ -->
    <section class="sg-hero">
      <div class="sg-hero-img" id="sgHeroImg" style={`background-image:url('${encodeURI(d.foto)}')`}></div>
      <div class="sg-hero-shade"></div>
      <div class="sg-floor" aria-hidden="true"><div class="sg-floor-grid"></div></div>

      <div class="sg-wrap sg-hero-in">
        <p class="sg-eyebrow" data-rv="up">{d.propiedad} · Publicada el {fFecha(inf.fecha_publicacion)}</p>
        <h1 class="sg-h1">
          <span class="sg-mask"><span data-rv="mask">Seguimiento</span></span>
          <span class="sg-mask"><span data-rv="mask" data-delay="120">de</span></span>
          <span class="sg-mask"><span data-rv="mask" data-delay="220" class="sg-accent">mi venta</span></span>
        </h1>

        <div class="sg-dash" data-rv="flip" data-delay="350">
          <div class="sg-tilt" data-tilt>
            <div class="sg-ring">
              <svg viewBox="0 0 128 128" aria-hidden="true">
                <defs>
                  <linearGradient id="sgGrad" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#6BAEDB" /><stop offset="1" stop-color="#0097D9" />
                  </linearGradient>
                </defs>
                <circle cx="64" cy="64" r={R} class="sg-ring-bg" />
                <circle cx="64" cy="64" r={R} class="sg-ring-fg" id="sgRing"
                  style={`stroke-dasharray:${CIRC};stroke-dashoffset:${CIRC}`} data-circ={CIRC} data-to={ringOffset} />
              </svg>
              <div class="sg-ring-txt">
                <strong><span data-count={diasPub}>{diasPub}</span></strong>
                <span>de {inf.dias_autorizacion} días</span>
              </div>
            </div>

            <div class="sg-dash-info">
              <div class="sg-now">
                <span class="sg-lbl">Etapa actual</span>
                <strong>{inf.estado}</strong>
              </div>
              <div class="sg-stats">
                <div><b data-count={T.exposicion}>{nf(T.exposicion)}</b><span>Exposición</span></div>
                <div><b data-count={T.clics}>{nf(T.clics)}</b><span>Clics</span></div>
                <div><b data-count={T.consultas}>{nf(T.consultas)}</b><span>Consultas</span></div>
                <div><b data-count={T.visitas}>{nf(T.visitas)}</b><span>Visitas</span></div>
              </div>
              <div class="sg-firma">Clics por día <b>{clicsDia}</b></div>
            </div>
          </div>

          <div class="sg-duo">
            <div class="sg-card3d sg-last" data-tilt>
              <span class="sg-lbl"><i class="sg-ico">✓</i>Lo destacado</span>
              <strong>{inf.destacado.titulo}</strong>
              <em>{inf.destacado.detalle}</em>
            </div>
            <div class="sg-card3d sg-next" data-tilt>
              <span class="sg-lbl"><i class="sg-ico sg-ico-pulse"></i>Lo próximo</span>
              <strong>{inf.proximo.titulo}</strong>
              <em>{inf.proximo.detalle}</em>
            </div>
          </div>
        </div>
      </div>

      <div class="sg-scroll" aria-hidden="true"><span></span></div>
    </section>

    <!-- ============ INFORME (fondo claro) ============ -->
    <div class="sg-light">
      <main class="sg-wrap sg-body">
        <div class="sg-main">

          <section class="sg-sec">
            <header class="sg-fase-head" data-rv="up">
              <span class="sg-fase-num" aria-hidden="true">01</span>
              <div>
                <p class="sg-eyebrow">Esta semana</p>
                <h2 class="sg-h2">Cómo vino <span class="sg-accent">la semana</span></h2>
                <p>{S.rango}</p>
              </div>
            </header>
            <div class="sg-kpis">
              {kpis.map((k, i) => (
                <div class="sg-kpi" data-rv="flip" data-delay={String(i * 70)} data-tilt="soft">
                  <span class="sg-lbl">{k.lab}</span>
                  <strong>{k.txt ?? <span data-count={k.val}>{nf(k.val)}</span>}</strong>
                  <em class={`sg-chip ${k.d.cls}`}>{k.d.txt}</em>
                </div>
              ))}
            </div>
            <div class="sg-lectura" data-rv="up">
              <span class="sg-accent">Mi lectura</span>
              <p>{inf.lectura}</p>
            </div>
          </section>

          <section class="sg-sec">
            <header class="sg-fase-head" data-rv="up">
              <span class="sg-fase-num" aria-hidden="true">02</span>
              <div>
                <p class="sg-eyebrow">Desde la publicación</p>
                <h2 class="sg-h2">Del aviso <span class="sg-accent">a la visita</span></h2>
                <p>Cada etapa filtra a la anterior. Así se ve cuánto interés termina en una visita real.</p>
              </div>
            </header>
            <ol class="sg-funnel">
              {embudo.map((e, i) => (
                <li data-rv="up" data-delay={String(i * 90)}>
                  {i > 0 && <span class="sg-conv">{conv(i)} pasa de {embudo[i - 1].lab.toLowerCase()} a {e.lab.toLowerCase()}</span>}
                  <div class="sg-fl">
                    <div class="sg-fl-txt"><b>{e.lab}</b><small>{e.ayuda}</small></div>
                    <div class="sg-fl-bar"><i style={`--w:${embudoW[i].toFixed(1)}%`}></i></div>
                    <strong data-count={e.v}>{nf(e.v)}</strong>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <section class="sg-sec">
            <header class="sg-fase-head" data-rv="up">
              <span class="sg-fase-num" aria-hidden="true">03</span>
              <div>
                <p class="sg-eyebrow">Día a día</p>
                <h2 class="sg-h2">Cómo viene <span class="sg-accent">funcionando</span></h2>
                <p>Clics por día en Zonaprop. Más de {U.prueba} por día confirma que el precio despierta interés.</p>
              </div>
            </header>
            <div class="sg-chart" data-rv="flip">
              <div class="sg-chart-scroll">
                <svg viewBox={`0 0 ${cW} ${cH}`} role="img" aria-label="Clics por día desde la publicación">
                  <rect class="z z1" x={cL} y={cy(U.especulacion)} width={cW - cL - cR} height={cy(0) - cy(U.especulacion)} />
                  <rect class="z z2" x={cL} y={cy(U.prueba)} width={cW - cL - cR} height={cy(U.especulacion) - cy(U.prueba)} />
                  <rect class="z z3" x={cL} y={cT} width={cW - cL - cR} height={cy(U.prueba) - cT} />
                  {[0, U.especulacion, U.prueba].map((v) => (
                    <g><line x1={cL} x2={cW - cR} y1={cy(v)} y2={cy(v)} class="gl" /><text x={cL - 8} y={cy(v) + 4} text-anchor="end">{v}</text></g>
                  ))}
                  {barras.map((b: any, i: number) => (
                    <g class="bar" style={`--i:${i}`}>
                      <rect x={b.x} y={b.y} width={bw} height={b.h} class={b.ult ? 'b ult' : 'b'} />
                      <text x={b.x + bw / 2} y={b.y - 8} text-anchor="middle" class={b.ult ? 'v ult' : 'v'}>{b.v}</text>
                      <text x={b.x + bw / 2} y={cH - 9} text-anchor="middle">{b.f}</text>
                    </g>
                  ))}
                </svg>
              </div>
              <div class="sg-zonas">
                <span><i class="z1"></i>Especulación · menos de {U.especulacion}</span>
                <span><i class="z2"></i>Prueba · {U.especulacion} a {U.prueba}</span>
                <span><i class="z3"></i>Validación · más de {U.prueba}</span>
              </div>
              {inf.semanas.length < 2 && <p class="sg-nota">Los gráficos por semana aparecen desde la segunda semana publicada.</p>}
            </div>
          </section>

          <section class="sg-sec">
            <header class="sg-fase-head" data-rv="up">
              <span class="sg-fase-num" aria-hidden="true">04</span>
              <div>
                <p class="sg-eyebrow">Origen</p>
                <h2 class="sg-h2">Consultas <span class="sg-accent">por portal</span></h2>
                <p>De dónde llega cada persona que escribe por tu departamento.</p>
              </div>
            </header>
            <ul class="sg-portales">
              {inf.portales.map((p: any, i: number) => {
                const pc = totPortal ? Math.round((p.consultas / totPortal) * 100) : 0;
                return (
                  <li data-rv="up" data-delay={String(i * 70)}>
                    <span class="sg-pn"><i style={`background:${p.color}`}></i>{p.nombre}</span>
                    <div class="sg-pb"><i style={`--w:${pc}%`}></i></div>
                    <span class="sg-pv"><b>{p.consultas}</b><small>{pc}%</small></span>
                  </li>
                );
              })}
            </ul>
          </section>

          <section class="sg-sec">
            <header class="sg-fase-head" data-rv="up">
              <span class="sg-fase-num" aria-hidden="true">05</span>
              <div>
                <p class="sg-eyebrow">Contexto</p>
                <h2 class="sg-h2">Comparado con <span class="sg-accent">el mercado</span></h2>
                <p>Lo que lleva tu departamento en {diasPub} días, contra lo que logran propiedades similares en todo su mes {M.mes}.</p>
              </div>
            </header>
            <div class="sg-bench">
              {mercado.map((m, i) => (
                <div class="sg-bench-row" data-rv="up" data-delay={String(i * 80)}>
                  <div class="sg-bench-top">
                    <b>{m.l}</b>
                    <span><strong>{nf(m.a)}</strong> de {nf(m.b)} promedio</span>
                  </div>
                  <div class="sg-bench-bar"><i style={`--w:${Math.min(m.pct, 100)}%`}></i><em style={`left:100%`}></em></div>
                  <span class="sg-bench-pct">{m.pct}% del mes {M.mes}</span>
                </div>
              ))}
            </div>
          </section>

          <section class="sg-sec">
            <header class="sg-fase-head" data-rv="up">
              <span class="sg-fase-num" aria-hidden="true">06</span>
              <div>
                <p class="sg-eyebrow">Interesados</p>
                <h2 class="sg-h2">Quién <span class="sg-accent">preguntó</span></h2>
                <p>Cada persona que consultó, en qué etapa está y qué dijo después de visitar.</p>
              </div>
            </header>
            <div class="sg-tabs" data-rv="up">
              <div class="sg-tablist" role="tablist" aria-label="Consultas por etapa">
                {tabs.map((t) => (
                  <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`pan-${t.id}`}
                    aria-selected={t.id === porTab ? 'true' : 'false'} tabindex={t.id === porTab ? '0' : '-1'}>
                    {t.lab}<span>{grupos[t.id].length}</span>
                  </button>
                ))}
              </div>
              {tabs.map((t) => (
                <div class="sg-tabpanel" role="tabpanel" id={`pan-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={t.id !== porTab}>
                  {grupos[t.id].length ? (
                    <ul class="sg-leads">
                      {grupos[t.id].map((c: any) => (
                        <li class="sg-lead" data-tilt="soft">
                          <span class="sg-avatar" aria-hidden="true"><span>{c.nombre.slice(0, 1)}</span></span>
                          <div class="sg-lead-txt">
                            <b>{c.nombre}</b>
                            <small>{fFecha(c.fecha)} · {c.fuente}</small>
                            {c.feedback && <p>«{c.feedback}»</p>}
                          </div>
                          <span class={`sg-etapa ${etapaCls(c.etapa)}`}>{c.etapa}</span>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="sg-vacio">{t.vacio}</p>
                  )}
                </div>
              ))}
            </div>
          </section>

          <section class="sg-sec">
            <div class="sg-intro" data-rv="up">
              <p class="sg-eyebrow">Cómo llegamos acá</p>
              <h2 class="sg-h2">El camino <span class="sg-accent">hasta publicar</span></h2>
              <p>El recorrido completo desde la tasación hasta la publicación, paso a paso.</p>
            </div>
            <details class="sg-camino" data-rv="up">
              <summary><span>Ver el recorrido</span><i aria-hidden="true"></i></summary>
              <div id="sgFases"></div>
            </details>
          </section>

          <p class="sg-updated">Actualizado el {inf.actualizado} · Próximo informe: {inf.proximo_informe}</p>
        </div>

        <aside class="sg-side">
          <div class="sg-price" data-rv="flip" data-tilt>
            <span class="sg-lbl">{d.precio.label}</span>
            <strong>{d.precio.valor}</strong>
          </div>

          <div class="sg-glass" data-rv="up">
            <span class="sg-lbl">Condiciones</span>
            <dl class="sg-conds">
              {d.condiciones.map((x: any) => (
                <div><dt>{x.lab}</dt><dd>{x.val}</dd></div>
              ))}
              <div><dt>Fin de autorización</dt><dd>{inf.fin_autorizacion}</dd></div>
            </dl>
          </div>

          <div id="sgDocs"></div>

          <div class="sg-glass sg-credito" data-rv="up">
            <span class="sg-accent sg-credito-t">Lo que sigue</span>
            <p>{d.despues}</p>
          </div>

          <a class="sg-wa" href={wa} target="_blank" rel="noopener" data-rv="up">Hablar con Jaco</a>
        </aside>
      </main>

      <footer class="sg-foot">
        <div class="sg-wrap">Malek Inmobiliaria · Jacobo Malek · CPI 8865</div>
      </footer>
    </div>

    <script is:inline define:vars={{ slug: d.slug, fases: d.fases, respaldo: d.respaldo, guia: d.guia }}>
      const meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
      const fmt = (iso) => { if (!iso) return ''; const [, m, day] = iso.slice(0,10).split('-').map(Number); return day + ' ' + meses[m-1]; };
      const $ = (id) => document.getElementById(id);
      const esc = (s) => (s || '').replace(/[&<>"]/g, (ch) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[ch]));
      const norma = (s) => (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const check = '<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      const nf = (n) => n.toLocaleString('es-AR');

      // Contadores: el número final ya está en el HTML; al aparecer, cuenta desde 0
      function countTo(el) {
        const to = +el.dataset.count;
        if (reduce || !to || el.dataset.done) return;
        el.dataset.done = '1';
        const t0 = performance.now(), dur = 1400;
        const step = (t) => {
          const k = Math.min(1, (t - t0) / dur), ease = 1 - Math.pow(1 - k, 4);
          el.textContent = nf(Math.round(to * ease));
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }

      // Pestañas de consultas
      const tabsBtns = [...document.querySelectorAll('.sg-tablist [role="tab"]')];
      function abrirTab(btn, foco) {
        tabsBtns.forEach((b) => {
          const on = b === btn;
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.tabIndex = on ? 0 : -1;
          $(b.getAttribute('aria-controls')).hidden = !on;
        });
        if (foco) btn.focus();
      }
      tabsBtns.forEach((b, i) => {
        b.addEventListener('click', () => abrirTab(b));
        b.addEventListener('keydown', (ev) => {
          if (ev.key === 'ArrowRight') abrirTab(tabsBtns[(i + 1) % tabsBtns.length], true);
          if (ev.key === 'ArrowLeft') abrirTab(tabsBtns[(i - 1 + tabsBtns.length) % tabsBtns.length], true);
        });
      });

      // Recorrido hasta la publicación (Notion)
      function htmlTarea(t) {
        return '<li class="sg-sub' + (t.listo ? ' is-done' : '') + '">' +
          '<span class="sg-box">' + check + '</span>' +
          '<div class="sg-sub-txt"><span class="sg-sub-title">' + esc(t.titulo) + '</span>' +
          (t.ayuda ? '<span class="sg-sub-help">' + esc(t.ayuda) + '</span>' : '') + '</div>' +
          '<span class="sg-date sg-date-sm' + (t.listo ? '' : ' is-est') + '">' + (t.listo ? '' : '~ ') + fmt(t.fecha) + '</span></li>';
      }
      function htmlEtapa(e, esActual) {
        const acc = norma(e.titulo).startsWith('prepar') && guia?.grupos?.length
          ? '<details class="sg-acc"><summary><span>' + esc(guia.titulo) + '</span><i aria-hidden="true"></i></summary>' +
            '<div class="sg-acc-body sg-guia">' + guia.grupos.map((g) =>
              '<div class="sg-guia-g"><h5>' + esc(g.titulo) + '</h5><ul>' +
              g.items.map((x) => '<li>' + esc(x) + '</li>').join('') + '</ul></div>').join('') +
            '</div></details>'
          : '';
        return '<li class="sg-step' + (e.listo ? ' is-done' : '') + (esActual ? ' is-current' : '') + '">' +
          '<span class="sg-node" aria-hidden="true"><span>' + check + '</span></span>' +
          '<article class="sg-panel">' +
            '<div class="sg-step-top"><h4>' + esc(e.titulo) + '<span class="sg-badge">En curso</span></h4>' +
            '<span class="sg-date' + (e.listo ? '' : ' is-est') + '">' + (e.listo ? '' : '~ ') + fmt(e.fecha) + '</span></div>' +
            (e.detalle ? '<p class="sg-step-detail">' + esc(e.detalle) + '</p>' : '') +
            (e.tareas.length ? '<ul class="sg-subs">' + e.tareas.map(htmlTarea).join('') + '</ul>' : '') +
            acc +
          '</article></li>';
      }
      function pintar(data) {
        const etapas = (data.etapas || []).map((e) => {
          const tareas = (e.tareas || []).map((t) => ({ ...t, listo: t.listo || e.listo }));
          const listo = e.listo || (tareas.length > 0 && tareas.every((t) => t.listo));
          return { ...e, tareas, listo };
        });
        if (!etapas.length) return;
        const lista = data.fases && data.fases.length ? data.fases : fases;
        const usadas = lista.filter((f) => etapas.some((e) => e.fase === f.id));
        const intro = Object.fromEntries(fases.map((f) => [f.id, f.intro]));
        const actual = etapas.find((e) => !e.listo);
        $('sgFases').innerHTML = usadas.map((f, i) => {
          const dentro = etapas.filter((e) => e.fase === f.id);
          return '<section class="sg-fase"><header class="sg-fase-head sg-fase-head-sm">' +
            '<span class="sg-fase-num" aria-hidden="true">0' + (i + 1) + '</span>' +
            '<div><h3>' + esc(f.titulo) + '</h3>' + (intro[f.id] ? '<p>' + esc(intro[f.id]) + '</p>' : '') + '</div></header>' +
            '<div class="sg-rail-wrap"><div class="sg-rail" aria-hidden="true"><i></i></div><ol class="sg-steps">' +
            dentro.map((e) => htmlEtapa(e, !!actual && actual.id === e.id)).join('') +
            '</ol></div></section>';
        }).join('');

        const docs = data.documentos || [];
        $('sgDocs').innerHTML = !docs.length ? '' : (() => {
          const ok = docs.filter((x) => x.ok).length;
          return '<details class="sg-glass sg-docs"><summary><div class="sg-docs-head">' +
            '<div class="sg-mini-ring" style="--p:' + (ok / docs.length) + '"><span>' + ok + '<small>/' + docs.length + '</small></span></div>' +
            '<div><span class="sg-lbl">Documentación</span><strong>' + (docs.length - ok > 1 ? 'Faltan ' + (docs.length - ok) : docs.length - ok === 1 ? 'Falta 1' : 'Completa') + '</strong></div>' +
            '<i class="sg-plus" aria-hidden="true"></i></div></summary><ul class="sg-docs-list">' +
            docs.map((x) => '<li class="' + (x.ok ? 'is-ok' : 'is-missing') + '"><span class="sg-box">' + (x.ok ? check : '') + '</span>' +
              '<span>' + esc(x.titulo) + '</span><em>' + (x.ok ? 'La tengo' : 'Falta') + '</em></li>').join('') +
            '</ul></details>';
        })();
        onScroll();
      }

      // Revelados 3D, inclinación con el mouse y parallax
      function animar() {
        const rv = document.querySelectorAll('[data-rv]:not(.in)');
        const entrar = (el) => {
          el.classList.add('in');
          el.querySelectorAll('[data-count]').forEach(countTo);
          if (el.matches('[data-count]')) countTo(el);
        };
        if (reduce || !('IntersectionObserver' in window)) { rv.forEach((el) => el.classList.add('in')); }
        else {
          const io = new IntersectionObserver((entries) => entries.forEach((en) => {
            if (!en.isIntersecting) return;
            setTimeout(() => entrar(en.target), +(en.target.dataset.delay || 0));
            io.unobserve(en.target);
          }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
          rv.forEach((el) => {
            if (el.closest('.sg-hero')) setTimeout(() => entrar(el), 150 + +(el.dataset.delay || 0));
            else io.observe(el);
          });
        }
        const ring = $('sgRing');
        setTimeout(() => { ring.style.strokeDashoffset = ring.dataset.to; }, reduce ? 0 : 500);

        if (!reduce && window.matchMedia('(hover: hover)').matches) {
          document.querySelectorAll('[data-tilt]').forEach((el) => {
            const max = el.dataset.tilt === 'soft' ? 3 : 8;
            el.addEventListener('pointermove', (ev) => {
              const r = el.getBoundingClientRect();
              const x = (ev.clientX - r.left) / r.width - 0.5, y = (ev.clientY - r.top) / r.height - 0.5;
              el.style.setProperty('--rx', (-y * max).toFixed(2) + 'deg');
              el.style.setProperty('--ry', (x * max).toFixed(2) + 'deg');
              el.style.setProperty('--mx', ((x + 0.5) * 100).toFixed(1) + '%');
              el.style.setProperty('--my', ((y + 0.5) * 100).toFixed(1) + '%');
            });
            el.addEventListener('pointerleave', () => { el.style.setProperty('--rx', '0deg'); el.style.setProperty('--ry', '0deg'); });
          });
        }
        onScroll();
      }

      const hero = $('sgHeroImg');
      let ticking = false;
      function onScroll() {
        const y = window.scrollY, vh = window.innerHeight;
        if (!reduce && hero && y < vh * 1.5) hero.style.transform = `translate3d(0, ${y * 0.35}px, 0) scale(${1.12 + y * 0.0002})`;
        document.querySelectorAll('.sg-rail-wrap').forEach((w) => {
          const r = w.getBoundingClientRect();
          w.style.setProperty('--fill', Math.max(0, Math.min(1, (vh * 0.6 - r.top) / r.height)));
        });
        ticking = false;
      }
      window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(onScroll); ticking = true; } }, { passive: true });

      animar();
      pintar(respaldo);
      fetch('/api/seguimiento/' + slug, { cache: 'no-store' })
        .then((r) => r.json())
        .then((res) => { if (res.ok && (res.etapas || []).length) pintar(res); })
        .catch(() => {});
    </script>
  </body>
</html>

<style is:global>
