---
// Panel de seguimiento para el propietario — Av. La Plata 100
// Datos fijos (condiciones, etapas, fechas estimadas): src/data/seguimiento/laplata100.json
// Estados en vivo: /api/seguimiento/laplata100 (worker/index.js → Notion, base Tareas)
import '../../styles/global.css';
import data from '../../data/seguimiento/laplata100.json';

const c = data.condiciones;
const meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const fmt = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${meses[m - 1]}`;
};
const firma = data.etapas[data.etapas.length - 1];
const totalEtapas = data.etapas.length;
const listosIniciales = data.etapas.filter((e) => e.listoInicial).length;
const pctInicial = Math.round((listosIniciales / totalEtapas) * 100);

const condiciones = [
  { lab: 'Valor cerrado', val: c.valor, destacado: true },
  { lab: 'Forma de pago', val: c.formaPago },
  { lab: 'Plazo de aprobación', val: c.plazoAprobacion },
  { lab: 'Plazo para la firma', val: c.plazoFirma },
  { lab: 'Entrega del departamento', val: c.entrega },
  { lab: 'Gastos de la operación', val: c.gastos },
  { lab: 'Lugar de firma', val: c.lugarFirma },
  { lab: 'Escribanía', val: c.escribania },
];

const money = (n: number | null) => (n ? `USD ${n.toLocaleString('es-AR')}` : 'A confirmar');
const waHref = `https://wa.me/5491122540182?text=${encodeURIComponent(
  `Hola Jaco! Te escribo por el seguimiento de la venta de ${data.propiedad}.`
)}`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Seguimiento de tu venta · {data.propiedad} | Malek Inmobiliaria</title>
    <meta name="description" content={`Estado de la venta de ${data.propiedad}, paso a paso.`} />
  </head>
  <body>
    <header class="sg-top">
      <div class="container sg-top-bar">
        <a href="/" aria-label="Malek Inmobiliaria - Inicio"><img src="/images/logo-malek-white.png" alt="Malek Inmobiliaria" /></a>
        <a class="sg-top-wa" href={waHref} target="_blank" rel="noopener">Escribime</a>
      </div>
    </header>

    <section class="sg-hero" style={`--foto:url('${encodeURI(data.foto)}')`}>
      <div class="container sg-hero-in">
        <p class="eyebrow">Seguimiento de tu venta</p>
        <h1>{data.propiedad}</h1>
        <p class="sg-hero-sub">{data.barrio} · CABA</p>

        <div class="sg-progress" aria-live="polite">
          <div class="sg-progress-head">
            <div>
              <span class="sg-label">Etapa actual</span>
              <strong id="sgActual" class="sg-actual">—</strong>
            </div>
            <div class="sg-pct"><span id="sgPct">{pctInicial}</span>%</div>
          </div>
          <div class="sg-bar"><div id="sgBar" class="sg-bar-fill" style={`width:${pctInicial}%`}></div></div>
          <div class="sg-progress-foot">
            <span><span id="sgHechos">{listosIniciales}</span> de {totalEtapas} pasos completos</span>
            <span>Firma estimada: <b id="sgFirma">{fmt(firma.estimado)}</b></span>
          </div>
        </div>
      </div>
    </section>

    <main>
      <section class="container sg-grid">
        <div class="sg-col-main">
          <h2 class="sg-h2">El camino hasta la firma</h2>
          <p class="sg-intro">
            Acá vas a ver cada paso a medida que avanza. Lo actualizo yo en cuanto hay novedades,
            así no tenés que andar preguntando. Las fechas en gris son estimadas.
          </p>

          {data.fases.map((fase, i) => (
            <div class="sg-fase">
              <div class="sg-fase-head">
                <span class="sg-fase-num">0{i + 1}</span>
                <h3>{fase.titulo}</h3>
              </div>
              <ol class="sg-steps">
                {data.etapas.filter((e) => e.fase === fase.id).map((e) => (
                  <li class={`sg-step ${e.listoInicial ? 'is-done' : ''}`} data-id={e.id} data-estimado={e.estimado}>
                    <span class="sg-dot" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="12" height="12"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <div class="sg-step-body">
                      <div class="sg-step-top">
                        <span class="sg-step-title">{e.titulo}</span>
                        <span class="sg-step-date">{e.listoInicial ? fmt(e.estimado) : `~ ${fmt(e.estimado)}`}</span>
                      </div>
                      <p class="sg-step-detail">{e.detalle}</p>
                      {e.id === 'reserva' && <p class="sg-monto">Monto: {money(data.montos.reserva)}</p>}
                      {e.id === 'refuerzo' && <p class="sg-monto">Monto: {money(data.montos.refuerzo)}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
          <p class="sg-updated" id="sgUpdated"></p>
        </div>

        <aside class="sg-col-side">
          <div class="sg-card">
            <h2 class="sg-h2 sg-h2-sm">Condiciones acordadas</h2>
            <dl class="sg-conds">
              {condiciones.map((x) => (
                <div class={x.destacado ? 'is-big' : ''}>
                  <dt>{x.lab}</dt>
                  <dd>{x.val}</dd>
                </div>
              ))}
              <div>
                <dt>Inventario incluido</dt>
                <dd><ul>{c.inventario.map((i) => <li>{i}</li>)}</ul></dd>
              </div>
            </dl>
          </div>

          <div class="sg-card sg-card-blue">
            <p class="sg-label">Sobre el crédito</p>
            <p>{data.credito}</p>
          </div>

          <div class="sg-card sg-card-dark">
            <p class="sg-accent">Cualquier duda</p>
            <p>Estoy a un mensaje. Si algo no te queda claro de este proceso, escribime y lo vemos.</p>
            <a class="btn btn-primary sg-btn" href={waHref} target="_blank" rel="noopener">Hablar con Jaco por WhatsApp</a>
          </div>
        </aside>
      </section>
    </main>

    <footer class="sg-foot">
      <div class="container">Malek Inmobiliaria · Jacobo Malek · CPI 8865</div>
    </footer>

    <script is:inline define:vars={{ slug: data.slug, etapas: data.etapas }}>
      const meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
      const fmt = (iso) => { const [y,m,d] = iso.slice(0,10).split('-').map(Number); return d + ' ' + meses[m-1]; };
      const $ = (id) => document.getElementById(id);

      function render(vivo) {
        const estado = {};
        etapas.forEach((e) => {
          const v = vivo && vivo[e.id];
          estado[e.id] = {
            listo: v ? v.listo : !!e.listoInicial,
            fecha: (v && v.fecha) || e.estimado,
            real: !!(v && v.fecha),
          };
        });
        const hechos = etapas.filter((e) => estado[e.id].listo).length;
        const actual = etapas.find((e) => !estado[e.id].listo);
        const pct = Math.round((hechos / etapas.length) * 100);

        document.querySelectorAll('.sg-step').forEach((li) => {
          const s = estado[li.dataset.id];
          li.classList.toggle('is-done', s.listo);
          li.classList.toggle('is-current', !!actual && actual.id === li.dataset.id);
          const fecha = li.querySelector('.sg-step-date');
          fecha.textContent = s.listo || s.real ? fmt(s.fecha) : '~ ' + fmt(s.fecha);
          fecha.classList.toggle('is-est', !s.listo && !s.real);
        });
        $('sgPct').textContent = pct;
        $('sgBar').style.width = pct + '%';
        $('sgHechos').textContent = hechos;
        $('sgActual').textContent = actual ? actual.titulo : '¡Venta concretada!';
        const f = estado.firma;
        $('sgFirma').textContent = (f.listo || f.real ? '' : '~ ') + fmt(f.fecha);
      }

      render(null);
      fetch('/api/seguimiento/' + slug, { cache: 'no-store' })
        .then((r) => r.json())
        .then((d) => {
          if (!d.ok) return;
          render(d.etapas);
          const t = new Date(d.actualizado);
          $('sgUpdated').textContent = 'Información actualizada al ' +
            t.toLocaleDateString('es-AR', { day: 'numeric', month: 'long' }) + ', ' +
            t.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', hour12: false }) + ' hs.';
        })
        .catch(() => {});
    </script>
  </body>
</html>

<style is:global>
  body { background: #F5F2EC; color: #0A0A0A; }
  .sg-top { background: #0A0A0A; }
  .sg-top-bar { display: flex; justify-content: space-between; align-items: center; padding-block: 1rem; }
  .sg-top-bar img { height: 34px; width: auto; }
  .sg-top-wa { color: #F5F2EC; font-weight: 700; font-size: 0.85rem; border: 1px solid rgba(245,242,236,0.35); padding: 0.5rem 1rem; border-radius: 2px; }
  .sg-top-wa:hover { border-color: #0097D9; color: #0097D9; }

  .sg-hero { position: relative; background: #0A0A0A; color: #F5F2EC; padding: 4rem 0 3rem; overflow: hidden; }
  .sg-hero::before { content: ''; position: absolute; inset: 0; background: var(--foto) center/cover no-repeat; opacity: 0.28; }
  .sg-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,0.35) 0%, #0A0A0A 100%); }
  .sg-hero-in { position: relative; z-index: 1; }
  .sg-hero h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); font-weight: 500; margin-top: 0.6rem; }
  .sg-hero-sub { color: #C9C5BE; margin-top: 0.6rem; }

  .sg-progress { margin-top: 2.5rem; background: rgba(245,242,236,0.06); border: 1px solid rgba(245,242,236,0.14); padding: 1.5rem; max-width: 760px; }
  .sg-progress-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; }
  .sg-label { display: block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #8C8A85; }
  .sg-actual { display: block; font-family: var(--font-display); font-weight: 500; font-size: 1.6rem; margin-top: 0.3rem; line-height: 1.1; }
  .sg-pct { font-family: 'Gotham', sans-serif; font-weight: 700; font-size: 2.6rem; color: #0097D9; line-height: 1; }
  .sg-bar { height: 6px; background: rgba(245,242,236,0.12); margin-top: 1.1rem; }
  .sg-bar-fill { height: 100%; background: #0097D9; transition: width 0.8s ease; }
  .sg-progress-foot { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.8rem; font-size: 0.85rem; color: #C9C5BE; flex-wrap: wrap; }
  .sg-progress-foot b { color: #F5F2EC; }

  .sg-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 3.5rem; padding-block: 4rem; align-items: start; }
  .sg-h2 { font-size: 2rem; font-weight: 500; }
  .sg-h2-sm { font-size: 1.5rem; margin-bottom: 1rem; }
  .sg-intro { color: #58595B; margin-top: 0.8rem; max-width: 56ch; }

  .sg-fase { margin-top: 2.5rem; }
  .sg-fase-head { display: flex; align-items: baseline; gap: 0.8rem; border-bottom: 1px solid #DCD6CB; padding-bottom: 0.6rem; }
  .sg-fase-num { font-family: 'Gotham', sans-serif; font-weight: 700; color: #0097D9; font-size: 0.85rem; letter-spacing: 0.08em; }
  .sg-fase-head h3 { font-size: 1.35rem; font-weight: 500; }

  .sg-steps { list-style: none; margin: 0; padding: 0; }
  .sg-step { position: relative; display: grid; grid-template-columns: 28px 1fr; gap: 1rem; padding: 1.1rem 0 0.2rem; }
  .sg-step::before { content: ''; position: absolute; left: 13px; top: 2.6rem; bottom: -1.1rem; width: 2px; background: #DCD6CB; }
  .sg-step:last-child::before { display: none; }
  .sg-step.is-done::before { background: #0097D9; }
  .sg-dot { width: 28px; height: 28px; border-radius: 50%; border: 2px solid #C9C5BE; background: #F5F2EC; display: grid; place-items: center; color: transparent; position: relative; z-index: 1; }
  .sg-step.is-done .sg-dot { background: #0097D9; border-color: #0097D9; color: #fff; }
  .sg-step.is-current .sg-dot { border-color: #0097D9; box-shadow: 0 0 0 5px rgba(0,151,217,0.18); animation: sgPulse 2s ease-in-out infinite; }
  .sg-step.is-current .sg-dot::after { content: ''; width: 10px; height: 10px; border-radius: 50%; background: #0097D9; position: absolute; }
  @keyframes sgPulse { 50% { box-shadow: 0 0 0 9px rgba(0,151,217,0.06); } }
  .sg-step-top { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .sg-step-title { font-weight: 700; font-size: 1rem; color: #8C8A85; }
  .sg-step.is-done .sg-step-title, .sg-step.is-current .sg-step-title { color: #0A0A0A; }
  .sg-step-date { font-family: 'Gotham', sans-serif; font-size: 0.82rem; white-space: nowrap; color: #0097D9; font-weight: 700; }
  .sg-step-date.is-est { color: #8C8A85; font-weight: 400; }
  .sg-step-detail { font-size: 0.9rem; color: #58595B; margin: 0.25rem 0 0; }
  .sg-step:not(.is-done):not(.is-current) .sg-step-detail { color: #8C8A85; }
  .sg-monto { font-size: 0.82rem; font-weight: 700; margin: 0.35rem 0 0; }
  .sg-step.is-current .sg-step-title::after { content: 'En curso'; margin-left: 0.6rem; font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; background: #E8F4FA; color: #00618C; padding: 0.2rem 0.5rem; vertical-align: 2px; }
  .sg-updated { font-size: 0.8rem; color: #8C8A85; margin-top: 2rem; }

  .sg-col-side { display: grid; gap: 1.25rem; position: sticky; top: 1.5rem; }
  .sg-card { background: #fff; padding: 1.75rem; border: 1px solid #DCD6CB; }
  .sg-conds { margin: 0; display: grid; }
  .sg-conds > div { padding: 0.8rem 0; border-top: 1px solid #F4F5F6; }
  .sg-conds > div:first-child { border-top: 0; padding-top: 0; }
  .sg-conds dt { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #8C8A85; }
  .sg-conds dd { margin: 0.25rem 0 0; font-size: 0.98rem; }
  .sg-conds .is-big dd { font-family: 'Gotham', sans-serif; font-weight: 700; font-size: 1.9rem; color: #0097D9; }
  .sg-conds ul { margin: 0; padding-left: 1.1rem; }
  .sg-card-blue { background: #E8F4FA; border-color: #CFE7F5; }
  .sg-card-blue p:last-child { margin: 0.5rem 0 0; font-size: 0.93rem; color: #0A0A0A; }
  .sg-card-dark { background: #0A0A0A; border-color: #0A0A0A; color: #F5F2EC; }
  .sg-card-dark p { color: #C9C5BE; font-size: 0.93rem; }
  .sg-accent { font-family: var(--font-accent); color: #0097D9 !important; font-size: 2rem !important; line-height: 1.2; margin-bottom: 0.9rem; }
  .sg-btn { width: 100%; justify-content: center; margin-top: 0.4rem; }

  .sg-foot { background: #0A0A0A; color: #8C8A85; font-size: 0.8rem; padding: 1.5rem 0; }

  @media (max-width: 860px) {
    .sg-grid { grid-template-columns: 1fr; gap: 2.5rem; padding-block: 2.5rem; }
    .sg-col-side { position: static; }
    .sg-hero { padding: 2.5rem 0 2rem; }
    .sg-actual { font-size: 1.3rem; }
    .sg-pct { font-size: 2rem; }
    .sg-progress { padding: 1.1rem; }
    .sg-step.is-current .sg-step-title::after { display: none; }
  }
</style>
